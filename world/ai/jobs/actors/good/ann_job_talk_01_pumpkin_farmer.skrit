Go			m_Go$;
GoMind		m_Mind$;
GoBody  	m_Body$;
Job			m_Job$;
Goid		m_Target$;

#include "k_job_c_mcp_fidget_utils"
#include "k_job_c_talk_utils"

startup state STARTUP$
{
}

////////////////////////////////////////////////////////////////////////////////
//	init

event OnJobInit$( Job job$ )
{
	m_Job$		= job$;
	m_Go$		= job$.Go;
	m_Mind$		= job$.Go.Mind;
	m_Body$		= job$.Go.Body;
	m_Target$	= job$.GoalObject;

	SetState Face$;
}


////////////////////////////////////////////////////////////////////////////////
//	face the audience
state Face$
{
	transition
	{
		-> Talk$:	OnWorldMessage( WE_MCP_FACING_LOCKEDON );
	}

	event OnEnterState$
	{
		if( !m_Go$.HasConversation )
		{
			report.errorf( "Actor '%s', scid:0x%08x was told to run job_talk but he doesn't have a conversation component.",
							m_Go$.GetTemplateName,
							m_Go$.Goid );
			SetState Exiting$;
		}
		MCPManager.MakeRequest( m_Go$.Goid, PL_FACE, m_Target$ );
	}
}


////////////////////////////////////////////////////////////////////////////////
//	blab blab away...
state Talk$
{
	transition
	{
		-> Exiting$:	OnWorldMessage( WE_REQ_TALK_END ) =
		{
			if( m_Go$.Mind.ActorAutoFidgets )
			{
				StartFidgetIfRequired$();
			}
		}
	}
	event OnEnterState$
	{
        if (Victory.GetQuestOrder( "quest_pumpkin_sniffers" ) > 6)
        {
            if ( GameAuditor.GetDb.GetBool( "ann_conv_01_pumpkin_farmer_after_quest_talked_to" ) )
            {
                m_Go$.GetConversation.RSSelectConversation( "ann_conv_01_pumpkin_farmer_after_quest_next" );
            }
            else
            {
                m_Go$.GetConversation.RSSelectConversation( "ann_conv_01_pumpkin_farmer_after_quest_first" );
                GameAuditor.GetDb.SetBool( "ann_conv_01_pumpkin_farmer_after_quest_talked_to", true );
            }
        }
        else if (Victory.GetQuestOrder( "quest_pumpkin_sniffers" ) == 6)
        {
            m_Go$.GetConversation.RSSelectConversation( "ann_conv_01_pumpkin_farmer_asking_for_second_pumpkin" );
        }
        else if (Victory.GetQuestOrder( "quest_pumpkin_sniffers" ) > 1)
        {
            m_Go$.GetConversation.RSSelectConversation( "ann_conv_01_pumpkin_farmer_after_asked_for_1st_pumpkin" );
        }
        else if (Victory.GetQuestOrder( "quest_pumpkin_sniffers" ) == 1)
        {
            m_Go$.GetConversation.RSSelectConversation( "ann_conv_01_pumpkin_farmer_asking_for_first_pumpkin" );
        }
        else
        {
            if ( GameAuditor.GetDb.GetBool( "ann_conv_01_pumpkin_farmer_b4_quest_talked_to" ) )
            {
                m_Go$.GetConversation.RSSelectConversation( "ann_conv_01_pumpkin_farmer_b4_quest_next" );
            }
            else
            {
                m_Go$.GetConversation.RSSelectConversation( "ann_conv_01_pumpkin_farmer_b4_quest_first" );
                GameAuditor.GetDb.SetBool( "ann_conv_01_pumpkin_farmer_b4_quest_talked_to", true );
            }
        }

		m_Go$.GetConversation.RSActivateDialogue();
	}
}


////////////////////////////////////////////////////////////////////////////////
//	finish blabbing
state Exiting$
{
	event OnEnterState$
	{
		// $$$ close up any dialogs here...

		// Send a PL_FACE reguest without a target so that they no longer
		// continue to face the character they were talking to
		MCPManager.MakeRequest( m_Go$.Goid, PL_FACE );

		m_Job$.MarkForDeletion();
	}
}