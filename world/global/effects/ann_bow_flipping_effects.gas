[effect_script*]
{
	name	=ann_bowl_passive_effect;
	script	=[[
			sfx create orbiter #TARGET
				"must_update()color0(.1,.3,.1)model(ann_ambient_item_big_bowl)radius(0)bone_orient()rotate(0, 0, 180)"; 
            sfx attach_point #PEEK @kill_bone target;
			sfx start #POP;
	]];
}
[effect_script*]
{
	name	=ann_treasure_passive_effect;
	script	=[[
			sfx create orbiter #TARGET
				"must_update()color0(.1,.3,.1)model(ann_ambient_item_treasure_under_bowl)radius(0)bone_orient()"; 
            sfx attach_point #PEEK @kill_bone target;
			sfx start #POP;
	]];
}
[effect_script*]
{
	name	=ann_bowl_moving_effect;

	script	=[[
			call ann_bowl_moving_effect_base s<velocity([0])dir(.2,0,0)>;

			worldmsg WE_SPELL_SYNC_END #OWNER_GOID #OWNER_GOID #TARGET_GOID;
			]];
}
[effect_script*]
{
	name	=ann_bowl_moving_effect_base;

	script	=[[
			/////////////////////////////////////////
			// This is the main trackball for the effect, everything is based off of this.
			sfx create trackball #TARGET_KB 
				"must_update()
				homing()damped()kdamp(.01)dur(#DEFAULT_TIMEOUT)afterlife(2)[0]
				invisible()no_collide_objects()";
			set $trackball #POP;
			sfx friendly party $trackball;

			sfx create orbiter #TARGET 
				"must_update()color0(.1,.3,.1)model(ann_ambient_item_big_bowl)radius(0)bone_orient()rotate(0, 0, 180)"; 
			set $projectile #POP;
			sfx rat $projectile;
			sfx target $projectile $trackball;
			sfx start $projectile;

			sfx start $trackball;

			]];
}