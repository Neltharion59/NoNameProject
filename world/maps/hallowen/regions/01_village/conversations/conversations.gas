[ann_conv_01_infested_cart_b4_quest_first]
{
	[text*]
	{
		activate_quest* = quest_haunted_cart,0;
	  b quest_dialog = true;
		screen_text = "Terror and horror, that's all there is left of this world! This cart of hay is the only thing I managed to salvage from my home. It could have been used for feeding animals in this village, for which I was hoping to be granted a shelter. But woe is me! Only gods know what possed my cart, my poor last pile of hay, and laid eggs in it. I tried to reach for some hay to feed the mules, but all I grabbed was slime and dirt. Most horrible things linger in my hay - spiders, maggots, frogs, and lizards. I had believed the world was doomed when my home was shred to pieces, but this sight was beyond all horrors comprehensible. Just try knocking on the cart wheel, and you'll see for yourself.";
	  f scroll_rate = 10.000000;
	}
}
[ann_conv_01_infested_cart_b4_quest_next]
{
	[text*]
	{
		screen_text = "I will not ever eat again. What if I reach for my oats just to feel slimy crawling beneath my hands? Oh no, this is the end of me.";
	  f scroll_rate = 10.000000;
	}
}
[ann_conv_01_infested_cart_after_quest_first]
{
	[text*]
	{
		activate_quest* = quest_haunted_cart,3;
		complete_quest* = quest_haunted_cart;
	  b quest_dialog = true;
		screen_text = "I thank you stranger. It is of some comfort to me that the vermin of my cart is dead. Yet I cannot bear the thought of this happening to me again, be it hay or my food. Here, have this, my appetite left me for good.";
	  f scroll_rate = 10.000000;
	}
}
[ann_conv_01_infested_cart_after_quest_next]
{
	[text*]
	{
		screen_text = "Creeping and crawling they are, in the damp darkness, their legs seeking solid ground, the one thing they took from me. The end draws near.";
	  f scroll_rate = 10.000000;
	}
}
[ann_conv_01_thief_caught_empty_handed_01]
{
	[text*]
	{
		screen_text = "Aaah, you spoilt a good snatch!";
	  f scroll_rate = 10.000000;
	}
}
[ann_conv_01_thief_caught_empty_handed_02]
{
	[text*]
	{
		screen_text = "I almost had it. Can you not leave honest working folk alone?";
	  f scroll_rate = 10.000000;
	}
}
[ann_conv_01_thief_caught_empty_handed_03]
{
	[text*]
	{
		screen_text = "Oh no! You cannot give people away like that.";
	  f scroll_rate = 10.000000;
	}
}
[ann_conv_01_thief_caught_with_haul_01]
{
	[text*]
	{
		screen_text = "Extortion! Why would you want to take MY things?";
	  f scroll_rate = 10.000000;
	}
}
[ann_conv_01_thief_caught_with_haul_02]
{
	[text*]
	{
		screen_text = "Nooo! My valuables that I honestly stole! You cannot steal them from me like that!";
	  f scroll_rate = 10.000000;
	}
}
[ann_conv_01_thief_caught_with_haul_03]
{
	[text*]
	{
		screen_text = "Not my haul! Not my precious haul!";
	  f scroll_rate = 10.000000;
	}
}
[ann_conv_01_thief_when_escaping]
{
	[text*]
	{
		screen_text = "I am empty-handed! There is nothing for you to take from me. Leave me alone!";
	  f scroll_rate = 10.000000;
	}
}
[ann_conv_01_thief_default]
{
	[text*]
	{
		screen_text = "The shine of jewels,\nthe cling of gold,\nI stash in sewers,\ntill I'm too old. Hahahaha!";
	  f scroll_rate = 10.000000;
	}
}
[conversation_child]
{
	[text*]
	{
		activate_quest* = quest_candy_snatcher,0;
	  b quest_dialog = true;
		screen_text = "A big, ugly monster called the Candy Snatcher stole my entire Halloween stash! Do you know what happens when I don't get my sugar? I become the REAL monster! Go smash that thief and bring back my sweets before I start biting people's ankles!";
	  f scroll_rate = 10.000000;
	}
}
[conversation_farmer]
{
	[text*]
	{
		activate_quest* = quest_pumpkin_sniffers,0;
		activate_quest* = quest_pumpkin_sniffers,1;
	  b quest_dialog = true;
		screen_text = "Listen here, hero! Sadly, pumpkin season is already over. The patch is empty, the glory is gone, but those Pumpkin Sniffers still haven’t lost interest! Luckily, I’ve got this strange ball that kind of looks like a pumpkin. Try using it to lure those weirdos away from here. It just might work… assuming they’re as dumb as they look!";
	  f scroll_rate = 10.000000;
	}
}
[conversation_innkeeper]
{
	[text*]
	{
		activate_quest* = quest_main_story,0;
	  b quest_dialog = true;
		screen_text = "Look at this gray mist creeping from the catacombs! It is an absolute disaster... it doesn't drink, it doesn't tip, and it's scaring away all my paying customers! I can't run a tavern if the only thing at the bar is an evil fog. Please, find the entrance to the underground and punch the source of this evil right in the face! Oh, and if you need supplies before you go... just ask. I'll even give you regular prices!";
	  f scroll_rate = 10.000000;
	}
}
[r01_companion]
{
	[text*]
	{
		choice = potential_member;
		screen_text = "Need help? I've got an arm to lend. Maybe two if I can find them.";
	  f scroll_rate = 30.000000;
	}
}
[r01_priest]
{
	[text*]
	{
		choice = more;
		order = 0;
		screen_text = "Long ago, there was a passage beneath this chapel that led down into the old tunnels. But in those depths, the priests discovered a terrible creature dwelling in the dark.";
	  f scroll_rate = 20.000000;
	}
	[text*]
	{
		order = 1;
		screen_text = "They sealed the entrance and blessed the stones above it. I only pray there is no other way down.";
	  f scroll_rate = 20.000000;
	}
}
[shop_armor]
{
	[text*]
	{
		choice = shop;
		screen_text = "Huh?";
	  f scroll_rate = 10.000000;
	}
}
[shop_magic]
{
	[text*]
	{
		choice = shop;
		screen_text = "Ahh... traveler. Your aura flickers like a candle in a storm.
Come closer, and I shall show you spells that might steady that flame... or set the world ablaze.
Gold first, magic after.";
	  f scroll_rate = 10.000000;
	}
}
[shop_potions]
{
	[text*]
	{
		choice = shop;
		screen_text = "My name is Tender... Bat Tender! Whether you're about to face that cursed fog, or you just survived it, you look like you need a strong drink. I've got health 'juice' and mana tonics. Gold first, heroism later!";
	  f scroll_rate = 10.000000;
	}
}
