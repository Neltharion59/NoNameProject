[r01_priest]
{
	[text*]
	{
		choice = more;
		order = 0;
		screen_text = "Long ago, there was a passage beneath this chapel that led down into the old tunnels. But in those depths, the priests discovered a terrible creature dwelling in the dark.";
	  f scroll_rate = 20.000000;
	}
	[text*]
	{
		order = 1;
		screen_text = "They sealed the entrance and blessed the stones above it. I only pray there is no other way down.";
	  f scroll_rate = 20.000000;
	}
}
[shop_armor]
{
	[text*]
	{
		choice = shop;
		screen_text = "Huh?";
	  f scroll_rate = 10.000000;
	}
}
[shop_bowl_token]
{
	[text*]
	{
		choice = shop;
		screen_text = "Welcome darling, welcome. Care to play a game with me? I show you which bowl hides the treasure, flip the bowls real quick and if you guess the one with treasure, you win! Simple enough.

To play the game, drop the token on the ground, and sharpen your eyes.";
	  f scroll_rate = 10.000000;
	}
}
[shop_magic]
{
	[text*]
	{
		choice = shop;
		screen_text = "Ahh... traveler. Your aura flickers like a candle in a storm.
Come closer, and I shall show you spells that might steady that flame... or set the world ablaze.
Gold first, magic after.";
	  f scroll_rate = 10.000000;
	}
}
[shop_potions]
{
	[text*]
	{
		choice = shop;
		screen_text = "My name is Tender... Bat Tender! Whether you're about to face that cursed fog, or you just survived it, you look like you need a strong drink. I've got health 'juice' and mana tonics. Gold first, heroism later!";
	  f scroll_rate = 10.000000;
	}
}
[shop_scrolls]
{
	[text*]
	{
		choice = shop;
		screen_text = "Welcome, friend! We offer the finest occult scrolls for your next necromantic session. Summon the skeletons that best match your needs today!";
	  f scroll_rate = 10.000000;
	}
}
[ann_r01_conv_wizard_by_barkrunners]
{
	[text*]
	{
		screen_text = "Hello! Worry not, we contained the walking trees or whatever they are between the carts. You are welcome to use one of the carts, just make sure not to sleep too close to the window. The poor girl's grandmother got eaten recently.";
	  f scroll_rate = 10.000000;
	}
