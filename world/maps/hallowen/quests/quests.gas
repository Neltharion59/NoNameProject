///////////////////////////////////////////////////////////////
// MAP QUESTS FILE (Halloween Mod)
///////////////////////////////////////////////////////////////

//////////////
// CHAPTERS //
//////////////

[chapters]
{
	[chapter_1]
	{
		screen_name = "Chapter 1: The Halloween Night";
		chapter_image = b_gui_ig_mnu_jnl_chapter_01;
		
		[*]
		{
			order = 0; 
			description = "A mysterious gray mist has engulfed the village.";
		}
	}
}

////////////
// QUESTS //
////////////

[quests]
{
	// ==========================================
	// HLAVNÁ LINKA (Main Quest) - Vstup do podzemia
	// ==========================================
	[quest_main_story]
	{
		chapter         = chapter_1;
		screen_name     = "Main Quest: Into the Darkness";
		victory_sample  = s_e_level_up_quest;
		quest_image     = b_gui_ig_mnu_jnl_quest_01;

		[*]
		{
			order       = 0;
			description = "Find someone to talk to about this strange place. Perhaps the local innkeeper might help.";
		}

		[*]
		{
			order       = 1;
			description = "Buy a permit to enter the catacombs from the innkeeper. Drop it near the entry to the catacombs.";
			speaker     = "Village Innkeeper";
			address     = 01_village:conversations:ann_conv_01_innkeep_b4_quest;
		}

		[*]
		{
			order       = 2;
			description = "Approach the catacombs.";
		}

		[*]
		{
			order       = 3;
			description = "Enter the catacombs.";
		}

		[*]
		{
			order       = 4;
			description = "Investigate the source of the mist.";
		}

		[*]
		{
			order       = 5;
			description = "Destroy the abomination.";
		}

		[*]
		{
			order       = 6;
			description = "Enter the castle.";
		}

		[*]
		{
			order       = 7;
			description = "Explore the castle.";
		}
	}

	// ==========================================
	// VEDĽAJŠÍ QUEST 1 (Pumpkin Sniffers)
	// ==========================================
	[quest_pumpkin_sniffers]
	{		
		chapter			= chapter_1;
		screen_name		= "Side Quest: The Pumpkin Sniffers"; 
		victory_sample	= s_e_level_up_quest;
		quest_image 	= b_gui_ig_mnu_jnl_quest_02;              
		
		[*]
		{
			order		    = 0;
			description     = "Find a way to defeat these creatures.";
		}

		[*]
		{
			order		    = 1;
			description     = "Speak with the farmer on the farm near the mill.";
			speaker         = "Garrioth";
			address		    = 01_village:conversations:conversation_farmer;
		}

		[*]
		{
			order		    = 2;
			description     = "Enter the pumpkin field.";
			speaker         = "Pumpkin Farmer";
			address		    = 01_village:conversations:ann_conv_01_pumpkin_farmer_asking_for_first_pumpkin;
		}

		[*]
		{
			order		    = 3;
			description     = "Find the prize-winning pumpkin.";
		}

		[*]
		{
			order		    = 4;
			description     = "Take the prize-winning pumpkin.";
		}

		[*]
		{
			order		    = 5;
			description     = "Defeat the pumpkin monster.";
			is_complete     = true; 
		}

		[*]
		{
			order		    = 6;
			description     = "Speak with the farmer.";
			is_complete     = true; 
		}

		[*]
		{
			order		    = 7;
			description     = "Take the prize-winning pumpkin from the field.";
			is_complete     = true;
			speaker         = "Pumpkin Farmer";
			address		    = 01_village:conversations:ann_conv_01_pumpkin_farmer_asking_for_second_pumpkin;
		}

		[*]
		{
			order		    = 8;
			description     = "Drop the pumpkin near the pumpkin-sniffers.";
			is_complete     = true; 
		}

		[*]
		{
			order		    = 9;
			description     = "Collect the prize from the ruined house.";
			is_complete     = true; 
		}

		[*]
		{
			order		    = 10;
			description     = "You have dealt with the pumpkin sniffer menace. One less horror for the local folk.";
			is_complete     = true; 
		}
	}

	// ==========================================
	// VEDĽAJŠÍ QUEST 2 (Candy Snatcher)
	// ==========================================
	[quest_candy_snatcher]
	{
		chapter			= chapter_1;		
		screen_name		= "Side Quest: The Candy Snatcher";
		victory_sample	= s_e_level_up_quest;
		quest_image 	= b_gui_ig_mnu_jnl_quest_03;              
		
		// STAV 0 (Zadanie)
		[*]
		{
			order			= 0;
			speaker         = "Crying Child";			
			description     = "I must track down the Candy Snatcher and retrieve the stolen Halloween sweets for the child.";
			address			= 01_village:conversations:conversation_child;	
		}
		
		// STAV 1 (Dokončenie - cukríky boli odovzdané dieťaťu)
		[*]
		{
			order			= 1;		
			description     = "I have defeated the monster and returned the stolen candy to the grateful child.";
			is_complete     = true; 
		}
	}

	// ==========================================
	// VEDĽAJŠÍ QUEST 3 (Haunted Cart)
	// ==========================================
	[quest_haunted_cart]
	{
		chapter			= chapter_1;		
		screen_name		= "Side Quest: Cart of Terrors";
		victory_sample	= s_e_level_up_quest;
		quest_image 	= b_gui_ig_mnu_jnl_quest_03;              
		
		[*]
		{
			order			= 0;
			speaker         = "Johnothros of Hay";			
			description     = "Knock on one of the wheels of the cart";
			address			= 01_village:conversations:ann_conv_01_infested_cart_b4_quest_first;
		}
		[*]
		{
			order			= 1;		
			description     = "Defeat the creepy crawly of the cart";
		}
		[*]
		{
			order			= 2;		
			description     = "Speak with Johnothros";
		}
		[*]
		{
			order			= 3;		
			description     = "Johnothros's cart is safe now";
		}
	}
}