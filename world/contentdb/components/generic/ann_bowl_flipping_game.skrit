property Scid BowlSpot01$ doc="Spot 1 of flipping bowl";
property Scid BowlSpot02$ doc="Spot 2 of flipping bowl";
property Scid BowlSpot03$ doc="Spot 3 of flipping bowl";
property Scid TokenCollectingTrigger$ doc="Trigger that collects tokens";
property string BowlPassiveEffect$ = "";
property string TreasurePassiveEffect$ = "";
property string BowlMovingEffect$ = "";
property string BowlMovingEffectVelocity$ = "0.5,0,0.5";
property float TreasureShowDelay$ = 1.0;
property float BowlShowDelay$ = 1.0;
property float BowlMoveDelay$ = 1.0;
property int BowlMoveTimes$ = 5;
property string RewardTemplate$	= ""	doc = "Which template to spawn when game won";

owner = GoSkritComponent;

SFxSID bowlPassiveEffectInstance01$;
SFxSID bowlPassiveEffectInstance02$;
SFxSID bowlPassiveEffectInstance03$;
SFxSID treasurePassiveEffectInstance$;
SFxSID bowlMovingEffectInstance01$;
SFxSID bowlMovingEffectInstance02$;
int treasureSpotIndex$ = -1;
int bowlMovingIndex1$ = -1;
int bowlMovingIndex2$ = -1;
int bowlMoveTimesCounter$ = 0;

SFxSID StartPassiveEffect$(string effect$, Scid target$)
{
    return SiegeFx.SRunMPScript( effect$, target$.Goid, target$.Goid, "", target$.Goid, WE_UNKNOWN );
}
SFxSID StartMovingEffect$(string effect$, Scid source$, Scid target$)
{
    return SiegeFx.SRunMPScript( effect$, source$.Goid, target$.Goid, BowlMovingEffectVelocity$, target$.Goid, WE_UNKNOWN );
}

Scid GetBowlSpot$(int index$)
{
    if (index$ == 0) { return BowlSpot01$; }
    else if (index$ == 1) { return BowlSpot02$; }

    return BowlSpot03$;
}
int GetBowlSpotIndex$(Scid bowlSpotScid$)
{
    if (bowlSpotScid$ == BowlSpot01$) { return 0; }
    else if (bowlSpotScid$ == BowlSpot02$) { return 1; }

    return 2;
}

SFxSID GetBowlPassiveEffectInstance$(int index$)
{
    if (index$ == 0) { return bowlPassiveEffectInstance01$; }
    else if (index$ == 1) { return bowlPassiveEffectInstance02$; }

    return bowlPassiveEffectInstance03$;
}

void StartBowlPassiveEffect$(int index$)
{
    if (index$ == 0) { bowlPassiveEffectInstance01$ = StartPassiveEffect$(BowlPassiveEffect$, BowlSpot01$); }
    else if (index$ == 1) { bowlPassiveEffectInstance02$ = StartPassiveEffect$(BowlPassiveEffect$, BowlSpot02$); }
    else { bowlPassiveEffectInstance03$ = StartPassiveEffect$(BowlPassiveEffect$, BowlSpot03$); }
}

void ToggleAvailability$(bool newValue$)
{
    BowlSpot01$.Go.Aspect.SSetIsSelectable( newValue$ );
    BowlSpot02$.Go.Aspect.SSetIsSelectable( newValue$ );
    BowlSpot03$.Go.Aspect.SSetIsSelectable( newValue$ );
}


startup state OnFirstLoaded$
{
    event OnGoHandleMessage$( eWorldEvent e$, WorldMessage )
	{
		if( e$ == WE_ENTERED_WORLD )
        {
            SetState Initial$;
        }
    }
}

state Initial$
{
    event OnEnterState$
    {
        ToggleAvailability$(false);
    }

    event OnGoHandleMessage$( eWorldEvent e$, WorldMessage )
	{
		if( e$ == WE_REQ_ACTIVATE )
        {
            SendWorldMessage( WE_TRIGGER_DEACTIVATE, owner.Goid, TokenCollectingTrigger$ );
            SetState ShowingTreasure$;
        }
    }
}

state ShowingTreasure$
{
    event OnEnterState$
    {
        treasureSpotIndex$ = Math.RandomInt( 3 ) % 3; // Don't trust math functions - be extra sure
        treasurePassiveEffectInstance$ = StartPassiveEffect$(TreasurePassiveEffect$, GetBowlSpot$(treasureSpotIndex$));

		this.CreateTimer( 1, TreasureShowDelay$ );
    }

    trigger OnTimer$(1)
	{
        SetState ShowingBowls$;
    }
}

state ShowingBowls$
{
    event OnEnterState$
    {
        SiegeFx.SStopScript( treasurePassiveEffectInstance$ );
        
        bowlPassiveEffectInstance01$ = StartPassiveEffect$(BowlPassiveEffect$, GetBowlSpot$(0));
        bowlPassiveEffectInstance02$ = StartPassiveEffect$(BowlPassiveEffect$, GetBowlSpot$(1));
        bowlPassiveEffectInstance03$ = StartPassiveEffect$(BowlPassiveEffect$, GetBowlSpot$(2));

		this.CreateTimer( 1, BowlShowDelay$ );
    }

    trigger OnTimer$(1)
	{
        SetState MovingBowls$;
    }
}

state MovingBowls$
{
    event OnEnterState$
    {
        bowlMovingIndex1$ = Math.RandomInt( 3 ) % 3;
        bowlMovingIndex2$ = Math.RandomInt( 3 ) % 3;
        if (bowlMovingIndex1$ == bowlMovingIndex2$) { bowlMovingIndex2$ = (bowlMovingIndex2$ + 1) % 3; }

        SiegeFx.SStopScript( GetBowlPassiveEffectInstance$(bowlMovingIndex1$) );
        SiegeFx.SStopScript( GetBowlPassiveEffectInstance$(bowlMovingIndex2$) );

        bowlMovingEffectInstance01$ = StartMovingEffect$(BowlMovingEffect$, GetBowlSpot$(bowlMovingIndex1$), GetBowlSpot$(bowlMovingIndex2$));
        bowlMovingEffectInstance02$ = StartMovingEffect$(BowlMovingEffect$, GetBowlSpot$(bowlMovingIndex2$), GetBowlSpot$(bowlMovingIndex1$));

		this.CreateTimer( 1, BowlMoveDelay$ );
    }

    trigger OnTimer$(1)
	{
        SetState LoopCheckBowls$;
    }
}

state LoopCheckBowls$
{
    event OnEnterState$
    {
        SiegeFx.SStopScript( bowlMovingEffectInstance01$ );
        SiegeFx.SStopScript( bowlMovingEffectInstance02$ );

        StartBowlPassiveEffect$(bowlMovingIndex1$);
        StartBowlPassiveEffect$(bowlMovingIndex2$);

        if (bowlMovingIndex1$ == treasureSpotIndex$) { treasureSpotIndex$ = bowlMovingIndex2$; }
        else if (bowlMovingIndex2$ == treasureSpotIndex$) { treasureSpotIndex$ = bowlMovingIndex1$; }

        bowlMovingIndex1$ = -1;
        bowlMovingIndex2$ = -1;

        bowlMoveTimesCounter$ = bowlMoveTimesCounter$ + 1;

        if (bowlMoveTimesCounter$ >= BowlMoveTimes$)
        {
            SetState BowlSwappingFinished$;
        }
        else
        {
            SetState MovingBowls$;
        }
    }
}

state BowlSwappingFinished$
{
    event OnEnterState$
    {
        ToggleAvailability$(true);
    }

    event OnGoHandleMessage$( eWorldEvent e$, WorldMessage msg$)
	{
		if( e$ == WE_REQ_ACTIVATE )
        {
            ToggleAvailability$(false);

            Scid selectedBowl$ = msg$.GetSendFrom().Scid;
            int selectedBowlIndex$ = GetBowlSpotIndex$(selectedBowl$);

            SiegeFx.SStopScript( GetBowlPassiveEffectInstance$(0) );
            SiegeFx.SStopScript( GetBowlPassiveEffectInstance$(1) );
            SiegeFx.SStopScript( GetBowlPassiveEffectInstance$(2) );

            if (selectedBowlIndex$ == treasureSpotIndex$)
            {
                treasurePassiveEffectInstance$ = StartPassiveEffect$(TreasurePassiveEffect$, selectedBowl$);

                // Award Reward
                GoCloneReq cloneReq$ = MakeGoCloneReq(RewardTemplate$);
                cloneReq$.FadeIn = true;
                cloneReq$.StartingPos	= owner.go.placement.position;
                GoDb.SCloneGo(cloneReq$);
            }

            SendWorldMessage( WE_TRIGGER_ACTIVATE, owner.Goid, TokenCollectingTrigger$ );

            SetState Initial$;
        }
    }
}