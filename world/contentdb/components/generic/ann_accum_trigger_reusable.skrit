//////////////////////////////////////////////////////////////////////////////

//////////////////////////////////////////////////////////////////////////////
// public definitions

// reserved tags
property bool			_server_only$			= false;
property string			_doc$					= "Accumulate trigger";

// exported properties
property int			num_til_send$			= 0					doc = "Number of messages to accumulate before triggering";
property eWorldEvent	message_increment$		= WE_REQ_ACTIVATE	doc = "Message to increment counter";
property eWorldEvent	message_decrement$		= WE_REQ_DEACTIVATE doc = "Message to decrement counter";

property eWorldEvent	message_when_active$	= WE_REQ_ACTIVATE	doc = "Message to send when triggered";

property scid      		send_to_scid$								doc = "Scid of object to receive message when triggered";
property int			send_data$;
owner = GoSkritComponent;

// globals
int						current_num_messages$	= 0;

//////////////////////////////////////////////////////////////////////////////

trigger OnGoDrawDebugHud$
{
	Goid goid$ = send_to_scid$.Goid;
	if( goid$.IsValid )
	{
		World.DrawDebugDirectedLine( owner.go.Placement.Position,
									 goid$.go.Placement.Position,
									 MakeColor( 0, 1.0, 0, 0.5 ),
									 ToString( message_when_active$ ) );
	}
}


void SendActivateMessageWithData$( scid scidToSendTo$, int data$ )
{
  Go goToSendTo$ = GoDb.FindGoidByScid( scidToSendTo$ ).Go;
  SendWorldMessage( message_when_active$, goToSendTo$.Goid, scidToSendTo$, data$ );
}

EvaluateMessageCount$
{
	// See if the message count is equal to or greater than our count
	if( current_num_messages$ >= num_til_send$ )
	{
		Report.Genericf( "Reusable Accum trigger 0x%08x : %d/%d - Sending\n", owner.scid, current_num_messages$, num_til_send$);

        //changed to support delays
		SendActivateMessageWithData$(send_to_scid$, send_data$);

        // Set to active
        current_num_messages$	= 0;
	}
	else
	{
		Report.Genericf( "Reusable Accum trigger 0x%08x : %d/%d - Not Sending\n", owner.scid, current_num_messages$, num_til_send$);
	}
}

event OnGoHandleMessage$( eWorldEvent e$, WorldMessage )
{
	if( e$ == message_increment$ )
	{
		Report.Genericf( "Reusable Accum trigger 0x%08x : %d/%d - Received increment message\n", owner.scid, current_num_messages$, num_til_send$);

		// Increment counter
		current_num_messages$	+= 1;

		// Evaluate
		EvaluateMessageCount$();
	}

	if( e$ == message_decrement$ )
	{
		Report.Genericf( "Reusable Accum trigger 0x%08x : %d/%d - Received decrement message\n", owner.scid, current_num_messages$, num_til_send$);

		// Increment counter
		current_num_messages$	-= 1;

		// Evaluate
		EvaluateMessageCount$();
	}
}
