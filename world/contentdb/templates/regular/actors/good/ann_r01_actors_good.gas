[t:template,n:ann_r01_shop_magic]
{
	category_name = "1W_shopkeep";
	doc = "ann_r01_shop_magic";
	specializes = base_npc_fg;
	[actor]
	{
		portrait_icon = b_gui_ig_i_ic_c_sikra;
	}
	[aspect]
	{
		use_range = 1.0;
		draw_selection_indicator = TRUE;
		is_ghost_usable = TRUE;
		model = m_c_gah_fg_pos_a7;
		[textures]
		{
			0 = b_c_gah_fg_skin_08;
			1 = b_c_pos_a7_048;
		}
	}
	[common]
	{
		screen_name = "Witchy Witch";
	}
	[conversation]
	{
		[conversations]
		{
			* = shop_magic;
		}
	}
	[inventory]
    {
        [store_pcontent]
        {
            full_ratio = 0;
			[magic]
			{
				[all*]
				{
					il_main = #spell/8-23;
					max = 20;
					min = 10;
				}
				[all*]
				{
					il_main = #spell/0-15;
					max = 25;
					min = 10;
				}
			}
			[misc]
			{
				[all*]
				{
					il_main = #spellbook/5-15;
					max = 3;
					min = 1;
				}
			}
        }
    }

	[store]
	{
		item_markup = 2;
		[item_restock]
			{
				scroll_resurrect = 2;
				spell_resurrect = 2;
				spell_revive = 2;
				spell_healing_hands = 2;
		
				spell_fireshot = 2;
				spell_zap = 2;
			}
	}
	[mind]
	{
		actor_may_attack = false;
		actor_may_be_attacked = false;
        jat_talk = world\ai\jobs\common\job_talk.skrit;
	}
}

