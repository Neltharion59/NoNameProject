[t:template,n:ann_r01_arena_krug_base]
{
    category_name = "1W_evil_a";
    doc = "ann r01 arena krug base";
    specializes = base_krug;
	[actor]
	{
		[skills]
		{
            dexterity = 4, 0;
            intelligence = 3, 0;
            strength = 5, 0;
            melee = 5, 0;
		}
	}
	[aspect]
	{
        experience_value = 0;
        life = 120;
        mana = 6;
        max_life = 120;
        max_mana = 6;
        selection_indicator_scale = 0.85;
	}
	[attack]
	{
        damage_max = 17;
        damage_min = 14;
	}

	[body]
	{
		min_move_velocity = 2.500;
		avg_move_velocity = 3.10;
		max_move_velocity = 4.8;
		[bone_translator]
		{
			  body_anterior  = bip01_head;
			  body_mid       = Bip01_Spine3;
			  body_posterior = bip01_pelvis;
			  kill_bone      = Bip01_Spine3;
			  shield_bone    = shield_grip;
			  weapon_bone    = weapon_grip;
		}
		[chore_dictionary]
		{
			  chore_prefix = a_c_eam_kg_fs;
			[chore_attack]
			{
				  chore_stances = 0,1;
				  skrit = select_attack;
				[anim_files]
				{
					  00 = at;
					  01 = at-04;
					  02 = at-02;
					  03 = at-03;
					  qffg = dff;
				}
			}
			[chore_default]
			{
				  chore_stances = 0,1;
				  skrit = infinite_loop;
				[anim_files]
				{
					  00 = dfs;
				}
			}
			[chore_die]
			{
				  chore_stances = 0,1;
				  skrit = select_transition;
				[anim_files]
				{
					  00 = di;
					  01 = di-02;
					  02 = di-03;
					  03 = di-04;
				}
			}
			[chore_fidget]
			{
				  chore_stances = 0,1;
				  skrit = select_fidget;
				[anim_files]
				{
					  00 = dsf;
					  01 = dsf-02;
					  02 = dsf-03;
				}
			}
			[chore_magic]
			{
				  chore_stances = 0;
				  skrit = select_attack;
				[anim_files]
				{
					  00 = mg;
				}
			}
			[chore_walk]
			{
				  chore_stances = 0,1;
				  skrit = select_walk;
				[anim_files]
				{
					  00 = wl;
					  01 = rl;
				}
			}
		}
	}
	[common]
	{
        screen_name = "Krug Gladiator";
        membership = monster;
	}
	[defend]
	{
        defense = 40;
	}

	[inventory]
	{
		[pcontent]
		{
			[oneof*]
			{
                es_weapon_hand = dg_g_c_1h_fun;
			}
		}
	}
	[mind]
	{
		on_enemy_spotted_alert_friends 		= true;
		jat_fidget							= world\ai\jobs\common\job_fidget.skrit
			?curious							= 0.75
			&interest							= interest
			&still								= false;

		jat_brain							= world\ai\jobs\common\brain_hero.skrit
			?actor_joins_existing_party			= true;

		jat_attack_object_melee 			= world\ai\jobs\common\job_attack_object_melee.skrit
			?run_chance 						= 1.0;
	}

	[physics]
	{
		break_effect = blood_mist;
        break_sound = s_e_meat_explosion;
        explode_when_killed = true;
        explosion_magnitude = 1.5;
		[break_particulate] {}
	}
}
[t:template,n:ann_r01_arena_krug_01]
{
    category_name = "1W_evil_a";
    doc = "ann r01 arena krug 01";
    specializes = ann_r01_arena_krug_base;
	[aspect]
	{
        scale_base = 0.85;
		[textures]
		{
			0 = b_c_eam_ksv;
		}
	}
	[common]
	{
        [template_triggers]
		{
			[*]
			{
				action* = send_world_message("we_req_activate",0x00100B9D,0f,"default","every",0);
				condition* = receive_world_message("we_killed");
			}
		}
	}
	[physics]
	{
		[break_particulate]
		{
			  frag_glb_krug_scavenger_01 = 1;
			  frag_glb_krug_scavenger_02 = 1;
			  frag_glb_krug_scavenger_03 = 1;
			  frag_glb_krug_scavenger_04 = 1;
			  frag_glb_krug_scavenger_05 = 1;
			  frag_glb_krug_scavenger_06 = 1;
			  frag_glb_krug_scavenger_07 = 1;
			  frag_glb_krug_scavenger_08 = 1;
		}
	}
}
[t:template,n:ann_r01_arena_krug_02]
{
    category_name = "1W_evil_a";
    doc = "ann r01 arena krug 02";
    specializes = ann_r01_arena_krug_base;
	[aspect]
	{
        scale_base = 0.9;
		[textures]
		{
			0 = b_c_eam_ksc;
		}
	}
    [actor]
    {
        alignment = aa_good;
    }
	[common]
	{
        [template_triggers]
		{
			[*]
			{
				action* = send_world_message("we_req_activate",0x00100B9E,0f,"default","every",0);
				condition* = receive_world_message("we_killed",0,"on_first_message");
			  b single_shot = true;
			}
		}
	}
	[physics]
	{
		[break_particulate]
		{
			  frag_glb_krug_scout_01 = 1;
			  frag_glb_krug_scout_02 = 1;
			  frag_glb_krug_scout_03 = 1;
			  frag_glb_krug_scout_04 = 1;
			  frag_glb_krug_scout_05 = 1;
			  frag_glb_krug_scout_06 = 1;
			  frag_glb_krug_scout_07 = 1;
			  frag_glb_krug_scout_08 = 1;
		}
	}
}