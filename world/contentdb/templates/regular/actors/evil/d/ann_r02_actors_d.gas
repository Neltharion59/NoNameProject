[t:template,n:ann_r02_bortusk_base]
{
	category_name = "1W_evil_d";
	doc = "ann_r02_bortusk_base";
	specializes = actor_evil;
	[aspect]
	{
		model = m_c_edm_bt_pos_1;
		[textures]
		{
			0 = b_c_edm_ann_bortusk_fleshy;
		}
		[voice]
		{
			[attack]
			{
				priority = high;
				* = s_e_ds2_gen_brtsk_atk1;
				* = s_e_ds2_gen_brtsk_atk2;
				* = s_e_ds2_gen_brtsk_atk3;
				* = s_e_ds2_gen_brtsk_atk4;
				* = s_e_ds2_gen_brtsk_atk5;
			}
			[die]
			{
				priority = high;
				* = s_e_ds2_gen_brtsk_die1;
				* = s_e_ds2_gen_brtsk_die2;
			}
			[enemy_spotted]	{ priority = high; * = s_e_ds2_gen_brtsk_sgt; }
			[hit_critical]	{ priority = low; * = s_e_ds2_gen_brtsk_hit; }
			[hit_glance]	{ priority = low; * = s_e_ds2_gen_brtsk_hit; }
			[hit_solid]		{ priority = low; * = s_e_ds2_gen_brtsk_hit; }
			[move]			{ priority = low; * = s_e_ds2_gen_brtsk_mve_lp; }
		}
	}
	[body]
	{
		avg_move_velocity = 3.650000;
		[bone_translator]
		{
			body_anterior = bip01_head;
			body_mid = bip01_spine;
			body_posterior = bip01_pelvis;
			kill_bone = bip01_spine;
			shield_bone = bip01_L_hand;
			weapon_bone = bip01_r_hand;
		}
		[chore_dictionary]
		{
			chore_prefix = a_c_edm_bt_fs;
			[chore_attack]
			{
				chore_stances = 0;
				skrit = select_attack;
				[anim_files]
				{
					00=at;
				}
				[anim_durations] { fs0 = 2.000; }
			}
			[chore_default]
			{
				chore_stances = 0;
				skrit = infinite_loop;
				[anim_files] { 00=dfs; }
			}
			[chore_die]
			{
				chore_stances = 0;
				skrit = select_transition;
				[anim_files]
				{
					00=di;
					01=di-02;
				}
			}
			[chore_fidget]
			{
				chore_stances = 0;
				skrit = select_fidget;
				[anim_files] { 00=dff; }
			}
			[chore_magic]
			{
				chore_stances = 0;
				skrit = select_attack;
				[anim_files]
				{
					00=at;
				}
				[anim_durations] { fs0 = 2.000; }
			}
			[chore_walk]
			{
				chore_stances = 0;
				skrit = select_walk;
				[anim_files]
				{
					00=wl-02;
				}
			}
		}
	}
	[common]
	{
        membership = monster;
	}
	[mind]
	{
		melee_engage_range = 16.0;
		personal_space_range = 0.7;
		ranged_engage_range = 16.0;
		sight_range = 16.0;
	}
}
[t:template,n:ann_r02_bortusk]
{
	category_name = "1W_evil_d";
	doc = "ann_r02_bortusk";
	specializes = ann_r02_bortusk_base;
	[actor]
	{
		[skills]
		{
			strength =  4, 0;
			intelligence =  4, 0;
			dexterity =  4, 0;
			combat_magic =  3, 0;
			melee =  3, 0;
		}
	}
	[aspect]
	{
		experience_value = 40;
        life = 71;
        mana = 20;
        max_life = 71;
        max_mana = 20;
		scale_base = 3;
	}
	[attack]
	{
		attack_range = 0.5s;
		damage_max = 10;
		damage_min = 10;
	}
	[body]
	{
		avg_move_velocity = 0.0;
	}
	[common]
	{
		membership=monster,immune_charm,immune_control,immune_freeze,immune_polymorph,immune_align_change,immune_explode;
		screen_name="Inhuman Centipede";
	}
	[defend] { defense=30; }
	/* // TODO - uncomment this when you have the googore_grub template ready
	[dsx_krakbone_spawn_monitor]
	{
		meleeTemplate = googore_grub_weak; // place the googore grub template name here into the double quotes
		rangedTemplate = googore_grub_weak; // place the googore grub template name here into the double quotes
		summonRatio1to2 = 0.5;
		maxTotalSummons = 4;
		maxSummons = 2;
		initialDelay = 1;
		waitInterval = 5;
	}
	*/
	[inventory]
	{
		selected_active_location = il_active_primary_spell;
		[other] { il_active_primary_spell=ann_r02_spell_bortusk; }
	}
    [mind]
    {
		actor_weapon_preference					= WP_MAGIC;
		actor_auto_switches_to_magic			= true;

		jat_die									= world\ai\jobs\actors\evil\job_die_explode.skrit;


		jat_flee_from_object					= jat_none;
		jat_guard         						= jat_none;
		jat_move          						= jat_none;
		jat_patrol         						= jat_none;

		on_engaged_lost_consciousness_abort_attack = true;
		movement_orders 						= mo_hold;
		melee_engage_range 						= 14.0;
		personal_space_range 					= 1;
		inner_comfort_zone_range 				= 2.0;
		melee_engage_range 						= 2.1;
		ranged_engage_range 					= 14.0;
		sight_range 							= 14.0;
    }
	[physics]
	{
		explosion_magnitude = 2.5;
		bone_box_collision = true;
		gib_gore_good = true;
		break_effect = blood_mist;
		explode_when_killed = true;
		break_sound = s_e_meat_explosion;
		[break_particulate]
		{
		}
	}
}

