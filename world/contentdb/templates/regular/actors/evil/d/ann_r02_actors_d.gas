[t:template,n:ann_r02_spider_base]
{
	category_name = "1W_evil_d";
	doc = "ann_r02_spider_base";
	specializes = spider_frostnid_base;
	[aspect]
	{
		material = ice;
		[voice]
		{
			[cast]			{ * = s_e_attack_frostnid; }
			[die]			{ priority = high; * = s_e_die_spider; }
			[enemy_spotted]	{ priority = high; * = s_e_call_spider_SED; }
		}
		[textures]
		{
			0 = b_c_edm_ann_frostnid;
		}
	}
	[attack]
	{
		attack_range = 0.5;
		damage_max = 16;
		damage_min = 8;
	}
	[mind]
	{
		actor_weapon_preference			= WP_MAGIC;
		actor_auto_switches_to_magic	= true;
		actor_auto_switches_to_karate	= false;
		actor_auto_switches_to_melee	= false;
	}
}
[t:template,n:ann_r02_spider]
{
	category_name = "1W_evil_d";
	doc = "ann_r02_spider";
	specializes = ann_r02_spider_base;
	[actor]
	{
		[skills]
		{
			strength =  1, 0;
			intelligence =  1, 0;
			dexterity =  3, 0;
            combat_magic =  3,  0;
		}
	}
	[aspect]
	{
		experience_value = 35;
		life = 24;
        max_life = 24;
        mana = 8;
		max_mana = 8;
	}
	[inventory]
	{
		selected_active_location = il_active_primary_spell;
		[other] { il_active_primary_spell=ann_r02_spell_frostnid; }
	}
	[common]
	{
		screen_name="Crystal Spitter";
		[template_triggers]
		{
			[*]
			{
				condition* = receive_world_message("WE_ENTERED_WORLD");
				single_shot = true;
				no_trig_bits=true;
				action* = call_sfx_script("unique_light_red(sgx)");
			}
		}
	}
    [defend] { defense=13; }
}
