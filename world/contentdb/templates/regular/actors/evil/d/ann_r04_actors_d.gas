[t:template,n:ann_r04_klaw]
{
	category_name = "1W_evil_d";
	doc = "ann_r04_klaw";
	specializes = base_klaw;
	[actor]
	{
		[skills]
		{
			strength =  13, 0;
			intelligence =  8, 0;
			dexterity =  12, 0;
            melee =  7,  0;
		}
	}
	[aspect]
	{
		experience_value = 130;
		life = 202;
        max_life = 202;
        mana = 18;
		max_mana = 18;
	}
	[attack]
	{
		attack_range = 0.5;
		damage_max = 54;
		damage_min = 46;
	}
	[common]
	{
		screen_name="Klaw";
		membership = party_klaw_boss, monster;
	}
    [defend] { defense=80; }
   	[inventory]
	{
    	[pcontent]
		{
			[oneof*]
			{
				[oneof*]
				{
				   chance = 0.05;
				   il_main = potion_health_small;
				   il_main = potion_mana_small;
				}
				[all*]
				{
       				chance = 0.02;
	                il_main = #spell/6-13;
				}

				[oneof*]
				{
					chance = 0.2;
					il_main = #*/26-33;
					il_main = #armor/13-66;
	                il_main = #weapon/26-33;
				}
				[oneof*]
				{
	                   chance = 0.004;
	                   il_main = #weapon/-rare(1)/34-41;
	                   il_main = #armor/-rare(1)/80-115;
                       il_main = #*/-rare(1)/34-41;
                }
				[oneof*]
				{
                       chance = 0.002;
	                   il_main = #weapon/-unique(2)/34-41;
	                   il_main = #armor/-unique(2)/80-115;
                       il_main = #*/-unique(2)/34-41;
	            }
				[gold*]
				{
					chance = 0.15;
					max = 150;
					min = 80;
				}
			}
		}
	}
	[mind]
	{
		jat_brain							= world\ai\jobs\common\brain_hero.skrit
			?actor_joins_existing_party			= true;
	}
}
[t:template,n:ann_r04_klaw_boss_01]
{
	category_name = "1W_evil_d";
	doc = "ann_r04_klaw_boss_01";
	specializes = base_klaw;
	[actor]
	{
		[skills]
		{
			strength 	=  14, 0;
			intelligence =  9, 0;
			dexterity 	=  12, 0;
            melee 		=  9,  0;
		}
	}
	[aspect]
	{
		experience_value = 400;
		life = 240;
        max_life = 240;
        mana = 18;
		max_mana = 18;
		textures:0 = b_c_edm_kw-02;
	}
	[attack]
	{
		attack_range = 0.5;
		damage_max = 54;
		damage_min = 46;
	}
	[common]
	{
		screen_name="Dark Klaw";
		membership=monster,immune_charm,immune_control,immune_freeze,immune_polymorph,immune_align_change,immune_explode;
		[template_triggers]
		{
			[*]
			{
				condition* = receive_world_message("WE_ENTERED_WORLD");
				single_shot = true;
				no_trig_bits = true;
				action* = call_sfx_script("unique_ray_purple(sgx)");
			}
		}
	}
    [defend] { defense=154; }
   	[inventory]
	{
    	[pcontent]
		{
			[all*]
			{
				[all*]
				{
					il_main = #armor,f/100-115;
	                il_main = #weapon/33-37;
				}
				[oneof*]
				{
	                   il_main = #weapon/-rare(1)/44-53;
	                   il_main = #armor/-rare(1)/112-119;
                       il_main = #*/-rare(1)/44-53;
                }
				[oneof*]
				{
                       chance = 0.50;
	                   il_main = #weapon/-unique(2)/44-53;
	                   il_main = #armor/-unique(2)/112-119;
                       il_main = #*/-unique(2)/44-53;
	            }
				[gold*]
				{
					max = 384;
					min = 241;
					min_pile = 41;
					piles = 2 - 4;
				}
			}
		}
	}
	[mind]
	{
		jat_fidget			= world\ai\jobs\common\job_fidget.skrit
			?social				= 0.8
			&approach_dist		= 2.5
			&friend_template	= false
			&friends			= party_klaw_boss
			&still				= false;

		jat_brain							 = world\ai\jobs\common\brain_hero.skrit
			?actor_creates_own_party			= true
			&party_template						= "party_klaw_boss";
	}
}

[t:template,n:ann_r04_spider_small]
{
	category_name = "1W_evil_d";
	doc = "ann_r04_spider_small";
	specializes = actor_evil;
	[actor]
	{
		[skills]
		{
			strength =  2, 0;
			intelligence =  1, 0;
			dexterity =  2, 0;
		}
	}
	[aspect]
	{
		experience_value = 25;
		life = 10;
		max_life = 10;
		mana = 10;
		max_mana = 10;
		model = m_c_edm_sp_pos_1;
		scale_base = 0.30;
		[voice]
		{
			[die]			{ priority = high; * = s_e_die_spider; }
			[enemy_spotted]	{ priority = high; * = s_e_call_spider; }
		}
	}
	[attack]
	{
		attack_range = 1;
		damage_max = 8;
		damage_min = 6;
		reload_delay = 1;
	}
	[body]
	{
		avg_move_velocity = 2.350000;
		[bone_translator]
		{
			body_anterior = bone02;
			body_mid = bone04;
			body_posterior = bone04;
			kill_bone = bone04;
			shield_bone = bone01;
			weapon_bone = bone02;
		}
		[chore_dictionary]
		{
			chore_prefix = a_c_edm_sp_fs;
			[chore_attack]
			{
				chore_stances = 0;
				skrit = select_attack;
				[anim_files] { 00=at; }
			}
			[chore_default]
			{
				chore_stances = 0;
				skrit = infinite_loop;
				[anim_files] { 00=dfs; }
			}
			[chore_die]
			{
				chore_stances = 0;
				skrit = select_transition;
				[anim_files] { 00=di; }
			}
			[chore_fidget]
			{
				chore_stances = 0;
				skrit = select_fidget;
				[anim_files] { 00=dff; }
			}
			[chore_walk]
			{
				chore_stances = 0;
				skrit = select_walk;
				[anim_files] { 00=wl; }
			}
		}
	}
	[common] { screen_name="Creepie"; }
	[mind]
	{
		melee_engage_range = 14.0;
		personal_space_range = 0.7;
		ranged_engage_range = 14.0;
		sight_range = 14.0;
	}
	[physics]
	{
		break_effect = spider_guts_black;
		explode_when_killed = true;
		explosion_magnitude = 1.0;
		gib_gore_good = true;
		[break_particulate]
		{
			ann_r01_spider_frag_01 = 1;
			ann_r01_spider_frag_02 = 3;
			ann_r01_spider_frag_03 = 5;
			ann_r01_spider_frag_04 = 5;
			ann_r01_spider_frag_05 = 1;
		}
	}
}

