[t:template,n:ann_r03_toreck_base]
{
	category_name = "1W_evil_d";
	doc = "ann_r03_toreck";
	specializes = actor_evil;
	[aspect]
	{
		model = m_c_ecm_to_pos_1;
		[voice]
		{
			[die]			{ priority = high; * = s_e_die_toreck; }
			[hit_critical]	{ priority = low; * = s_e_hit_toreck_SED; }
			[hit_glance]	{ priority = low; * = s_e_hit_toreck_SED; }
			[hit_solid]		{ priority = low; * = s_e_hit_toreck_SED; }
		}
		[textures]
		{
			0 = b_c_ecm_ann_toreck;
		}
	}
	[attack]
	{
		attack_range = 0.5;
		damage_max = 20;
		damage_min = 12;
	}
	[body]
	{
		avg_move_velocity = 2.340000;
		max_move_velocity = 3.7;
		[bone_translator]
		{
			body_anterior = bip01_head;
			body_mid = bip01_spine1;
			body_posterior = bip01_pelvis;
			kill_bone = bip01_spine1;
			shield_bone = shield_grip;
			weapon_bone = weapon_grip;
		}
		[chore_dictionary]
		{
			chore_prefix = a_c_ecm_to_fs;
			[chore_attack]
			{
				chore_stances = 5;
				skrit = select_attack;
				[anim_files]
				{
					00 = at;
					01 = at-02;
				}
			}
			[chore_default]
			{
				chore_stances = 5;
				skrit = infinite_loop;
				[anim_files] { 00=ds; }
			}
			[chore_die]
			{
				chore_stances = 5;
				skrit = select_transition;
				[anim_files] { 00=di; }
			}
			[chore_fidget]
			{
				chore_stances = 5;
				skrit = select_fidget;
				[anim_files] { 00=dff; }
			}
			[chore_magic]
			{
				chore_stances = 5;
				skrit = select_attack;
				[anim_files]
				{
					00 = at;
					01 = at-02;
				}
			}
			[chore_walk]
			{
				chore_stances = 5;
				skrit = select_walk;
				[anim_files] { 00=wl; }
			}
		}
		[weapon_scales]
		{
			as_staff	= 1.8, 1.8, 1.8;
		}
	}
	[mind]
	{
		jat_attack_object_melee 			= world\ai\jobs\common\job_attack_object_melee.skrit
			?run_chance 					= 1.0;
		jat_fidget							= world\ai\jobs\common\job_fidget.skrit
			?curious							= 0.75
			&interest							= interest
			&meander							= false
			&still								= false;

		melee_engage_range = 14;
		personal_space_range = 0.7;
		ranged_engage_range = 14.0;
		sight_range = 14.0;
	}
}
[t:template,n:ann_r03_toreck]
{
	category_name = "1W_evil_d";
	doc = "ann_r03_toreck";
	specializes = ann_r03_toreck_base;
	[actor]
	{
		[skills]
		{
			strength =  	2, 0;
			intelligence =  2, 0;
			dexterity =  	3, 0;
			melee =  		5, 0;
			combat_magic =  		5, 0;
		}
	}
	[aspect]
	{
		experience_value = 44;
		life = 47;
		max_life = 47;
		mana = 14;
		max_mana = 14;
	}
	[common] { screen_name="Soul Sweeper"; }
   	[inventory]
	{
		selected_active_location = il_active_primary_spell;
		[other]
		{
			il_active_primary_spell=ann_monster_spell_bombard_soul;
		}
		[equipment]
		{
			es_weapon_hand = ann_weapon_toreck;
		}
    	[pcontent]
		{
			[oneof*]
			{
				[oneof*]
				{
					chance = 0.35;
					il_main = #*/10-20;
					il_main = #armor/10-20;
				}
				[oneof*]
				{
	            	chance = 0.004;
	                il_main = #weapon/-rare(1)/12-25;
	                il_main = #armor/-rare(1)/15-30;
                    il_main = #*/-rare(1)/12-20;
                }
				[oneof*]
				{
                	chance = 0.002;
	                il_main = #weapon/-unique(2)/12-15;
	                il_main = #armor/-unique(2)/20-25;
                    il_main = #*/-unique(2)/12-15;
	            }
				[gold*]
				{
					chance = 0.125;
					max = 60;
					min = 30;
				}
    		}
		}
	}
}
[t:template,n:ann_r03_toreck_boss_01]
{
	category_name = "1W_evil_d";
	doc = "ann_r03_toreck_boss_01";
	specializes = ann_r03_toreck_base;
	[actor]
	{
		[skills]
		{
			strength =  	2, 0;
			intelligence =  2, 0;
			dexterity =  	3, 0;
			combat_magic =  9, 0;
		}
	}
	[aspect]
	{
		experience_value = 354;
		life = 354;
		max_life = 354;
		mana = 200;
		max_mana = 200;
		scale_base = 1.33;
	}
	// TODO - give him effects and looks worthy of being a "SOUL" sweeper - cape-like apearance, dead witch spawn, spirit orbiters/frags?
	[common]
	{
		screen_name="Grand Soul Maiden";
		[template_triggers]
		{
			[*]
			{
				condition* = receive_world_message("WE_ENTERED_WORLD");
				single_shot = true;
				no_trig_bits=true;
				action* = call_sfx_script("unique_ray_blue(sgx)");
				action* = call_sfx_script("unique_light_blue(sgx)");
			}
		}
	}
   	[inventory]
	{
		selected_active_location = il_active_primary_spell;
		[other]
		{
			il_active_primary_spell=ann_monster_spell_bombard_soul;
		}
		[equipment]
		{
			es_weapon_hand = ann_weapon_toreck;
		}
    	[pcontent]
		{
			[all*]
			{
				[gold*]
				{
					max = 460;
					min = 230;
				}
				[oneof*]
				{
					il_main = #*/20-40;
					il_main = #armor/30-60;
					min = 1;
					max = 2;
				}
				[oneof*]
				{
	                il_main = #weapon/-rare(1)/20-40;
	                il_main = #armor/-rare(1)/30-60;
                    il_main = #*/-rare(1)/20-40;
                }
				[oneof*]
				{
                	chance = 0.75;
	                il_main = #weapon/-unique(2)/20-40;
	                il_main = #armor/-unique(2)/30-60;
                    il_main = #*/-unique(2)/20-40;
	            }
    		}
		}
	}
}

[t:template,n:ann_r03_vampire_base]
{
	category_name = "1W_evil_d";
	doc = "ann_r03_vampire_base";
	specializes = base_bandit;
	[common]
	{
		membership = monster, party_bandit_ranged, bandit;
	}
   	[mind]
   	{
		jat_brain						= world\ai\jobs\common\brain_hero.skrit
			?actor_joins_existing_party	= true;
		jat_fidget		= world\ai\jobs\common\job_fidget.skrit
			?curious		= 0.75
			&interest		= interest
			&meander		= true
			&still			= false;

		actor_weapon_preference			= WP_MAGIC;
		actor_auto_switches_to_magic	= true;
		actor_auto_switches_to_karate	= true;
		actor_auto_switches_to_melee	= true;
		actor_auto_heals_self_life	= true;
		on_enemy_entered_icz_switch_to_melee = true;
	}
	[ann_spawn_on_death]
	{
		spawn_template = ann_bat_volatile;
		spawn_count = 8;
		minDistance = 0.1;
		maxDistance = 0.3;
	}
}
