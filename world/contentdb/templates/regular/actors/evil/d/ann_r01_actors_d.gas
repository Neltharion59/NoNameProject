        [bone_translator]
		{
			 kill_bone			= bone01;
			 weapon_bone		= spine_1;
			 shield_bone		= spine_1;
			 body_anterior		= spine_1;
			 body_mid			= spine_3;
			 body_posterior		= spine_5;
		}
		[chore_dictionary]
		{
			chore_prefix = a_c_edm_gb_fs;

			[chore_attack]
			{
