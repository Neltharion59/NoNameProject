				chore_stances = 0;

				anim_files:00 = dfs;
			}

			[chore_fidget]
			{
				skrit = select_fidget;
				chore_stances = 0;

				anim_files:00 = dff;
				anim_files:01 = dff-02;
			}

			[chore_walk]
			{
				skrit = select_walk;
				chore_stances = 0;

				anim_files:00 = wl;
				anim_files:01 = wl-02;
			}
		}
	}
	[common]
	{
		screen_name = "Sleazy Grub";
        [template_triggers]
		{
			[*]
			{
				action* = send_world_message("we_req_activate",0x00100509,0f,"default","every",0);
				condition* = receive_world_message("we_killed",0,"on_first_message");
			  b single_shot = true;
			}
		}
	}
	[defend] { defense=5; }
	[mind]
	{
		jat_fidget	= world\ai\jobs\common\job_fidget.skrit;
		
		melee_engage_range  	= 14;
		personal_space_range	= 0.7;
		ranged_engage_range 	= 14.0;
		sight_range				= 14.0;
	}
	[physics]
	{
		explode_when_killed = true;
		break_effect = blood_mist;
		break_sound = s_e_meat_explosion;
		[break_particulate]
