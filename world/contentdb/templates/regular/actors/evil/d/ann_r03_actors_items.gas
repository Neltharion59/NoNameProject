	}
}
[t:template,n:ann_r03_possessed_helmet_01]
{
	category_name = "1W_evil_d";
	doc = "ann_r03_possessed_helmet_01";
	specializes = ann_r03_possessed_helmet_base;
	[common]
	{
		[template_triggers]
		{
			[*]
				{
					action* = call_sfx_script("ann_flying_effect_helmet_01");
					condition* = receive_world_message("WE_ENTERED_WORLD");
					single_shot = true;
				}
		}
	}
