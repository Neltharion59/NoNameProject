[t:template,n:ann_r03_item_base]
{
	category_name = "1W_evil_d";
	doc = "ann_r03_item_base";
	specializes = dsx_zepheryl_base;

	aspect:	model		= <none>;
	aspect:	material	= steel;

	[common]
	{
		membership = gargoyle,monster;
	}
	[aspect]
	{
		experience_value = 37;
		force_no_render = true;
		life = 13;
		max_life = 13;
		mana = 8;
		max_mana = 8;
		draw_shadow = false;
		scale_base = 1;	 

		model = m_c_edm_ga_pos_1;

		[voice]
		{
			[die]			{ priority = high;	* = s_e_die_zepheryl_SED;		}
			[enemy_spotted]	{ priority = high; * = s_e_call_zepheryl_SED; }
			[hit_critical]	{ priority = low;	* = s_e_hit_zepheryl_SED;		}
			[hit_glance]	{ priority = low;	* = s_e_hit_zepheryl_SED;		}
			[hit_solid]		{ priority = low;	* = s_e_hit_zepheryl_SED;		}
		}
	}
	[actor]
	{
		[skills]
		{
			strength 		=	2, 0;
			intelligence 	=	 2, 0;
			dexterity 		=	2, 0;
			melee 	=	2, 0;
			combat_magic 	=	2, 0;
			nature_magic 	=	2, 0;
				
		}
	}
	[attack]
	{
		attack_range = .5;
		damage_max = 10;
		damage_min = 3;
	}
	[common]
	{
		screen_name="Headseeker";
		membership = gargoyle, monster, immune_polymorph;
	}
	[defend] { 
		defense=14; 
	}
	[inventory]
	{
		selected_active_location = il_active_primary_spell;
		[other] { il_active_primary_spell=ann_flying_item_spell; }
	}
	[mind]
	{
		actor_weapon_preference		= WP_MAGIC;
		actor_auto_switches_to_magic	= true;
		actor_auto_switches_to_karate	= false;
		actor_auto_switches_to_melee	= false;
	}
}
[t:template,n:ann_r03_item_melee_base]
{
	category_name = "1W_evil_d";
	doc = "ann_r03_item_melee_base";
	specializes = ann_r03_item_base;

	[attack]
	{
		attack_range = .5;
		damage_max = 8;
		damage_min = 4;
	}
	[mind]
	{
		actor_weapon_preference		= WP_MELEE;
		actor_auto_switches_to_karate	= true;
		actor_auto_switches_to_melee	= true;
	}
	
	[body]
	{
		avg_move_velocity = 7.990000;
		[bone_translator]
		{
			body_anterior = bone01;
			body_mid = bone01;
			body_posterior = bone01;
			kill_bone = bone01;
			shield_bone = bone01;
			weapon_bone = bone01;
		}
		[chore_dictionary]
		{
			chore_prefix = a_c_edm_ga_fs;
			[chore_attack]
			{
				chore_stances = 0;
				skrit = select_attack;
				[anim_files]
				{
					00 = at;
					01 = at-02;
				}
		 	  	[anim_durations]
				{
					fs0 = 0.15;
					fs1 = 0.15;
				}
			}
			[chore_magic]
			{
				chore_stances = 0;
				skrit = select_attack;
				[anim_files]
				{
					00 = mg;
				}
			}
			[chore_default]
			{
				chore_stances = 0;
				skrit = infinite_loop;
				[anim_files] { 00=ds; }
			}
			[chore_die]
			{
				chore_stances = 0;
				skrit = select_transition;
				[anim_files] { 00=dfs; }
			}
			[chore_fidget]
			{
				chore_stances = 0;
				skrit = select_fidget;
				[anim_files] { 00=dff; }
			}
			[chore_misc]
			{
				chore_stances = 0;
				skrit = select_transition;
				[anim_files]
				{
					slep = ds;
					wake = rv;
				}
			}
			[chore_walk]
			{
				chore_stances = 0;
				skrit = basic_walk;
				[anim_files] { 00=fl; }
			}
		}
	}
}
[t:template,n:ann_r03_item_magic_base]
{
	category_name = "1W_evil_d";
	doc = "ann_r03_item_magic_base";
	specializes = ann_r03_item_base;

	[inventory]
	{
		selected_active_location = il_active_primary_spell;
		[other] { il_active_primary_spell=ann_flying_item_spell; }
	}
	[mind]
	{
		actor_weapon_preference		= WP_MAGIC;
		actor_auto_switches_to_magic	= true;
		actor_auto_switches_to_karate	= false;
		actor_auto_switches_to_melee	= false;
	}
}




[t:template,n:ann_r03_possessed_helmet_base]
