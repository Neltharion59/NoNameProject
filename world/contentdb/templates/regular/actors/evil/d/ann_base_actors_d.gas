[t:template,n:ann_base_rat]
{
	category_name = "1W_evil_d";
	doc = "ann_base_rat";
	specializes = actor_evil;
	[aspect]
	{
		material = teeth;
		model = m_c_edm_gr_pos_1;
		[voice]
		{
			[die]
			{
				* = s_e_die_rat;
			}
			[hit_critical]
			{
				* = s_e_hit_rat_SED;
			}
			[hit_glance]
			{
				* = s_e_hit_rat_SED;
			}
			[hit_solid]
			{
				* = s_e_hit_rat_SED;
			}
		}
	}
	[attack]
	{
		attack_range = 0.5;
	}
	[body]
	{
		avg_move_velocity = 3.000000;
		max_move_velocity = 5;
		[bone_translator]
		{
			body_anterior = bip01_head;
			body_mid = bip01_spine;
			body_posterior = bip01_tail;
			kill_bone = bip01_spine;
			shield_bone = bip01_spine;
			weapon_bone = bip01_head;
		}
		[chore_dictionary]
		{
			chore_prefix = a_c_edm_gr_fs;
			[chore_attack]
			{
				chore_stances = 0;
				skrit = select_attack;
				[anim_files] { 00=at; }
			}
			[chore_default]
			{
				chore_stances = 0;
				skrit = infinite_loop;
				[anim_files] { 00=ds; }
			}
			[chore_die]
			{
				chore_stances = 0;
				skrit = select_transition;
				[anim_files] { 00=di; }
			}
			[chore_fidget]
			{
				chore_stances = 0;
				skrit = select_fidget;
				[anim_files] { 00=dff; }
			}
			[chore_walk]
			{
				chore_stances = 0;
				skrit = select_walk;
				[anim_files] { 00=rl; }
			}
		}
	}
	[common]
	{	screen_name="Rat";
		membership = rat, monster;
	}
   	
	[mind]
	{
		jat_brain						 = world\ai\jobs\common\brain_hero.skrit
			?actor_joins_existing_party		= true;

		jat_attack_object_melee 			= world\ai\jobs\common\job_attack_object_melee.skrit
			?run_chance 					= 1.0;

		jat_fidget = world\ai\jobs\common\job_fidget.skrit
			?social				= 0.8
			&social_limit		= 2
			&move_distance		= 3.00
			&delay_min			= 7.0
			&delay_max			= 17.0
			&approach_dist		= 1.75
			&friends			= "rat"
			&still				= false;

		melee_engage_range = 14.0;
		personal_space_range = 0.7;
		ranged_engage_range = 14.0;
		sight_range = 14.0;
		sight_origin_height = 1.5;
	}
	[physics]
	{
		break_effect = blood_mist;
		break_sound = s_e_meat_explosion;
		[break_particulate]
		{
			frag_glb_generic_01 = 1;
			frag_glb_generic_02 = 1;
			frag_glb_generic_03 = 1;
			frag_glb_generic_04 = 1;
			frag_glb_generic_05 = 1;
			frag_glb_generic_06 = 1;
			frag_glb_generic_07 = 1;
			frag_glb_generic_08 = 1;
		}
	}
	[water_effects] {}
}
///////////////////////////////////////////////////////////////////////////////
//
//		BASE MONSTER TEMPLATES
//
///////////////////////////////////////////////////////////////////////////////
[t:template,n:ann_familiar_taxabani_base]// "tax-a-bon-ee" :)
{
	category_name = "1W_evil_d";
	doc = "ann_familiar_taxabani_base";
	specializes = actor_evil;
	[aspect]
	{
		material = steel;
		model = m_c_xeam_006_pos_1;
		[voice]
		{
			[cast]
			{
				priority = high;
				* = s_e_ds2_gen_x_txbni_atk;
				* = s_e_ds2_gen_x_txbni_atk2;
			}
			[die]			{priority = high; * = s_e_ds2_gen_x_txbni_die1;}
			[enemy_spotted]	{ priority = high; * = s_e_ds2_gen_fttrshn2_sgt; }
			[hit_critical]	{ priority = low; * = s_e_ds2_gen_x_txbni_hit; }
			[hit_glance]	{ priority = low; * = s_e_ds2_gen_x_txbni_hit; }
			[hit_solid]		{ priority = low; * = s_e_ds2_gen_x_txbni_hit; }
			[move]			{ priority = low; * = s_e_ds2_gen_x_txbni_mve_lp; }
			[revive]		{ priority = always; * = s_e_ds2_gen_x_txbni_revive; }
		}
	}
	[body]
	{
		terrain_movement_permissions = lf_mist | lf_dirt;
		min_move_velocity = 3.2;
		avg_move_velocity = 3.7;
		max_move_velocity = 5.0;
		[bone_translator]
		{
			body_anterior = bip01_head;
			body_mid = bip01_spine;
			body_posterior = bip01_pelvis;
			kill_bone = bip01_spine1;
			shield_bone = bip01_L_hand;
			weapon_bone = bip01_r_hand;
		}
		[chore_dictionary]
		{
			chore_prefix = a_c_xeam_006_FS;
			[chore_attack]
			{
				chore_stances = 0;
				skrit = select_attack;
				[anim_files]
				{
					01=at-02;
				}
				[anim_durations]
				{
					fs0 = 2.000;
				}
			}
			[chore_die]
			{
				chore_stances = 0;
				skrit = select_transition;
				[anim_files]
				{
					00=di;
				}
			}
			[chore_default]
			{
				chore_stances = 0;
				skrit = infinite_loop;
				[anim_files]
				{
					00=dfs;
				}
			}
			[chore_fidget]
			{
				chore_stances = 0;
				skrit = select_fidget;
				[anim_files]
				{
					00=dff;
				}
			}
			[chore_magic]
			{
				chore_stances = 0;
				skrit = select_attack;
				[anim_files]
				{
					01=at-02;
				}
				[anim_durations]
				{
					fs0 = 2.000;
				}
			}
			[chore_misc]
			{
				chore_stances = ignore;
				skrit = select_transition;
				[anim_files]
				{
					res1 = a_c_xeam_006_FS0_rsct;
				}
			}
			[chore_walk]
			{
				chore_stances = 0;
				skrit = select_walk;
				[anim_files]
				{
					00=rl;
				}
			}
		}
	}
	[common]
	{
		screen_name = "Taxabani Familiar";
	}
}