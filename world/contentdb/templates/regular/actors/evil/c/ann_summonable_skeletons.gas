////////////////////////////////////////////
////////////// SKELETON MELEE //////////////
////////////////////////////////////////////
[t:template,n:ann_summonable_skeleton_melee_common]
{
	category_name = "1W_evil_c";
	doc = "Ann [summon] Skeleton Melee Common";
	specializes = skeleton_base;
	aspect:experience_value = 0;
	[common] { screen_name="[Common] Skeleton Fighter"; }
	[inventory]
	{
		spew_equipped_kill_count = <ignore>;
		[pcontent]
		{
			[oneof*] { es_weapon_hand = #club/2-3; }
		}
	}
	mind:jat_brain = world\ai\jobs\common\brain_hero.skrit;
}
[t:template,n:ann_summonable_skeleton_melee_uncommon]
{
	category_name = "1W_evil_c";
	doc = "Ann [summon] Skeleton Melee Uncommon";
	specializes = skeleton_base;
	aspect:experience_value = 0;
	[common] { screen_name="[Uncommon] Skeleton Fighter"; }
	[inventory]
	{
		spew_equipped_kill_count = <ignore>;
		[pcontent]
		{
			[oneof*]{ es_weapon_hand = #mace/9; }
			[oneof*] { es_shield_hand = #shield/10-50; }
		}
	}
	mind:jat_brain = world\ai\jobs\common\brain_hero.skrit;
}
