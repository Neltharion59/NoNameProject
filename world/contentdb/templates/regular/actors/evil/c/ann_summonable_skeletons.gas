		[pcontent]
		{
			[oneof*]
			{
				es_shield_hand = bw_g_d_s_s_c_avg;
				es_shield_hand = bw_g_c_s_s_c_avg;
				es_shield_hand = bw_g_c_c_m_4_fun;
				es_shield_hand = bw_g_c_c_m_4_low;
			}
		}
	}
	mind:jat_brain = world\ai\jobs\common\brain_hero.skrit;
}
