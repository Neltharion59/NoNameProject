[t:template,n:ann_spellbook_chanelling_healing_base]
{
	doc = "ann_spellbook_chanelling_healing_base";
	specializes = ann_spellbook_chanelling_base;
	[aspect]
	{
		[textures]
		{
			0 = b_i_glb_book-magic-04;
		}
	}
    [common]
    {
        screen_name = "Channelling Spellbook of Healing";
    }
	[gui]
	{

		inventory_icon = b_gui_ig_i_it_magic-book-04;
	}
}
[t:template,n:ann_spellbook_chanelling_healing_cheaper_01]
{
	doc = "ann_spellbook_chanelling_healing_cheaper_01";
	specializes = ann_spellbook_chanelling_healing_base;
	[magic]
	{
		[enchantments]
		{
            [*]
            {
                alteration = alter_spell_cost;
			    imbued_spell_group = spells_healing;
                is_imbued = true;
                multiply_value = true;
                value = 0.85;
			    description = "Decreases the mana cost of Healing spells in this spellbook by 15% at the cost of mana capacities of the wearer";
                duration = #infinite;
                is_permanent = true;
                is_single_instance = false;
            }
            [*]
            {
                alteration = alter_max_mana;
                multiply_value = true;
                value = 0.95;
			    description = "-5% Max Mana";
                duration = #infinite;
                is_permanent = true;
                is_single_instance = false;
            }
        }
	}
}
