[t:template,n:ann_wpn_summonable_skeleton_ranged_epic]
{
	category_name = "weapon";
	doc = "ann_wpn_summonable_skeleton_ranged_epic";
	specializes = base_bow;
	[aspect]
	{
		model = m_w_bow_017;
	}
	[attack]
	{
		attack_range = 13;
	  f damage_max = 28.000000;
	  f damage_min = 24.000000;
		reload_delay = 0.3;
	}
	[common]
	{
        is_pcontent_allowed	= false;
	}
    [gui]
    {
        is_droppable = false;
    }
	[magic]
	{
		[enchantments]
		{
			[*]
			{
				alteration = alter_piercing_damage_chance_ranged;
				description = "+15% chance to inflict a Piercing Hit";
				duration = #infinite;
				is_permanent = true;
				is_single_instance = false;
				value = 15;
			}
            [lightning_chance]
            {
                alteration		= alter_custom_damage_chance_ranged;
                custom_damage		= lightning;
                value			= 15;
                description		= "+15% Chance of Lightning Strike";
                duration		= #infinite;
                is_permanent		= true;
                is_single_instance	= false;
            }
            [lightning_damage]
            {
                alteration		= alter_custom_damage_chance_ranged;
                custom_damage		= lightning;
                value			= 12;
                max_value		= 17;
                description		= " of 12 to 17 Damage";
                duration		= #infinite;
                is_permanent		= true;
                is_single_instance	= false;
                effect_script_equip	= lightning_scythe;
                effect_script_hit	= hit_lightning_scythe;
            }
		}
	}
}
