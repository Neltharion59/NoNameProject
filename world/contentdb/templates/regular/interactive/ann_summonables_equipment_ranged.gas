[t:template,n:ann_amr_hlmt_summonable_skeleton_ranged_rare]
{
	doc = "ann_amr_hlmt_summonable_skeleton_ranged_rare";
	specializes = base_helm;
	[common]
	{
        is_pcontent_allowed	= false;
	}
    [gui]
    {
        is_droppable = false;
    }
	[defend]
	{
		armor_style = 006;
		armor_type = type6;
	  f defense = 3.000000;
	}
	[magic]
	{
		[enchantments]
		{
			[*]
			{
				alteration = alter_special_defense;
				special_defense = zap;
				description = "+33% Chance to Cast Zap (4-8 DMG) on Taking Damage";
				duration = #infinite;
				is_permanent = true;
				is_single_instance = false;
				value = 33;
				special_defense_skrit = world\global\skrits\special_defense.skrit?damage_min=4&damage_max=8&effect_script="zap";
			}
			[*]
			{
				alteration = alter_chance_to_dodge_hit_melee;
				description = "+15% Chance to Dodge Physical attacks";
				duration = #infinite;
				is_permanent = true;
				is_single_instance = false;
				value = 15;
			}
			[*]
			{
				alteration = alter_chance_to_dodge_hit_ranged;
				duration = #infinite;
				is_permanent = true;
				is_single_instance = false;
				value = 15;
			}
		}
	}
}
