[t:template,n:ann_r05_spell_worm_dancing_acid]
{
	category_name = "magic";
	doc = "ann_r05_spell_worm_dancing_acid";
	specializes = base_spell_monster;
	[attack]
	{
		damage_max = 17;
		damage_min = 23;
	}
	[magic]
	{
		cast_range = 14;
		cast_reload_delay = 1;
		effect_duration = 7;
		does_damage_per_second = true;
		requires_line_of_sight = true;
		speed_bias = 1;
		target_type_flags = tt_conscious_enemy | tt_unconscious_enemy | tt_breakable | tt_terrain;
		usage_context_flags = uc_offensive;
	}
	[spell_fire]
	{
		effect_script = ann_effect_dancing_acid;
		particle_fit = 0.1;
		ignite = false;
	}
}
[t:template,n:ann_r05_spell_darkling_spark]
{
	category_name = "magic";
	doc = "ann_r05_spell_darkling_spark";
	specializes = ann_base_spell_monster_nmagic;
	[attack]
	{
		damage_max = 24;
		damage_min = 20;
	}
	[common]
	{
		[template_triggers]
		{
			[*]
			{
				action* = call_sfx_script("darkling_spark");
				condition* = receive_world_message("we_req_cast");
			}
		}
	}
	[magic]
	{
		cast_range = 15;
		cast_reload_delay = 0.5;
		mana_cost = 0;
		requires_line_of_sight = true;
		speed_bias = 1;
		target_type_flags = tt_conscious_enemy;
		usage_context_flags = uc_offensive;
	}
	[spell_default] {}
}
[t:template,n:ann_r05_spell_darkling_implosion]
{
	category_name = "magic";
	doc = "ann_r05_spell_darkling_implosion";
	specializes = ann_base_spell_monster_nmagic;
	[attack]
	{
		damage_max = 45;
		damage_min = 40;
	}
	[common]
	{
		[template_triggers]
		{
			[*]
			{
				action* = call_sfx_script("implosion");
				condition* = receive_world_message("we_req_cast");
			}
		}
	}
	[magic]
	{
		cast_range = 0.5;
		cast_reload_delay = 3;
		requires_line_of_sight = true;
		speed_bias = 1;
		target_type_flags = tt_conscious_enemy | tt_unconscious_enemy | tt_breakable;
		usage_context_flags = uc_offensive;
	}
	[spell_instant_hit] {}
}
[t:template,n:ann_r05_spell_darkling_mana_shield]
{
	category_name = "magic";
	doc = "ann_r05_spell_darkling_mana_shield";
	specializes = ann_monster_spell_mana_shield_base;
	[magic]
	{
		effect_duration = 10;
		[enchantments]
		{
			[*]
			{
				alteration = alter_mana_shield;
				description = "Mana shield";
				duration = 10;
				value = 100;
			}
		}
	}
}