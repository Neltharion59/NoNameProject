[t:template,n:ann_r01_trs_token_bowl_flip]
{
	category_name = "treasure";
	doc = "ann_r01_trs_token_bowl_flip";
	specializes = treasure;
	[aspect]
	{
		gold_value = 15;
        model = m_i_glb_token-coin-01;
		[textures]
        {
            0 = b_i_glb_token-coin-01;
        }
        [voice]
		{
			[put_down]
			{
				* = s_e_gui_put_down_jewelry;
			}
		}
	}
	[common]
	{
		screen_name = "Bowl Game Token";
	}
	[gui]
	{
		can_sell = false;
		inventory_icon	=  b_gui_ig_i_it_token-coin-01;
	}
}
