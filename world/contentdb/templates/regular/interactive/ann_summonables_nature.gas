[t:template,n:ann_scroll_summon_base_magic_nature]
{
	doc = "Ann Scroll Summon Base Nature Magic";
	specializes = spell;

	[aspect]
	{
		model			= m_i_glb_scroll;
	}

	gui:	inventory_icon	=  b_gui_ig_i_ic_sc_001_inv;

	[common]
	{
		[template_triggers]
		{
			[*]
			{
				action* = call_sfx_script( "nature_spell_sparkle" );
				condition* = receive_world_message("we_dropped");
			}
		}
	}
	[magic]
	{
		magic_class = mc_nature_magic;
		skill_class = "Nature Magic";
	}
}
[t:template,n:ann_scroll_summon_skeleton_base_magic_nature]
{
	category_name = "magic";
	doc = "Ann Scroll Summon Skeleton base Nature Magic";
	specializes = ann_scroll_summon_base_magic_nature;
	[common]
	{
		description = "Summons a Common Skeleton to guard the caster. Adds experience to caster's Nature Magic skill.";
		screen_name = "Summon Skeleton Scroll";
	}
	[magic]
	{
		one_use = true;
        
		apply_enchantments = false;
		cast_range = 10;
		cast_reload_delay = 1;
		caster_state_name = "Controlling";
		effect_duration = 360;
		is_one_shot = true;
		mana_cost = 1;
		requires_line_of_sight = true;
		speed_bias = 1;
		target_type_flags = tt_terrain;
		usage_context_flags = uc_passive;
	}
	[spell_summon]
	{
		effect_script = "summon";
		end_script = "un_summon";
		description = "Summoned Creature";
		caster_description = "Controlling Summoned";
	}
}
[t:template,n:ann_scroll_summon_skeleton_common_magic_nature]
{
	category_name = "magic";
	doc = "Ann Scroll Summon Skeleton Common Nature Magic";
	specializes = ann_scroll_summon_base_magic_nature;
	[aspect]
	{
		gold_value = 10;
	}
	[gui]
	{
		active_icon = b_gui_ig_i_ic_sp_091_ss_common;
		inventory_icon	=  b_gui_ig_i_ic_sc_001_inv_common;
	}
	[magic]
	{
		[enchantments]
		{
			[*]
			{
				alteration = alter_strength;
				duration = #infinite;
				value = (((((#magic + 1)*0.64)+10)*1)-#str) * 0.7;
			}
			[*]
			{
				alteration = alter_dexterity;
				duration = #infinite;
				value = (((((#magic + 1)*0.27)+10)*.5)-#dex) * 0.7;
			}
			[*]
			{
				alteration = alter_intelligence;
				duration = #infinite;
				value = (((((#magic + 1)*0.09)+10)*.1)-#int) * 0.7;
			}
			[*]
			{
				alteration = alter_melee;
				duration = #infinite;
				value = (((#magic + 1)-2)-#melee) * 0.7;
			}
			[*]
			{
				alteration = alter_ranged;
				duration = #infinite;
				value = (((#magic + 1)-2)-#ranged) * 0.7;
			}
			[*]
			{
				alteration = alter_combat_magic;
				duration = #infinite;
				value = (((#magic + 1)-2)-#combat_magic) * 0.7;
			}
			[*]
			{
				alteration = alter_nature_magic;
				duration = #infinite;
				value = (((#magic + 1)-2)-#nature_magic) * 0.7;
			}
			[*]
			{
				alteration = alter_armor;
				duration = #infinite;
				value = ((((#magic + 1)*9)*1.25)-#base_defense) * 0.7;
			}
			[*]
			{
				alteration = alter_max_life;
				duration = #infinite;
				value = ((((#magic + 1)*24)*0.9)-#maxlife) * 0.7;
			}
			[*]
			{
				alteration = alter_life;
				duration = 1.0;
				value = ((((#magic + 1)*24)*0.9)) * 0.7;
			}
			[*]
			{
				alteration = alter_max_mana;
				duration = #infinite;
				value = ((((#magic + 1)*19)*0.02)-#maxmana) * 0.7;
			}
			[*]
			{
				alteration = alter_mana;
				duration = 1.0;
				value = ((((#magic + 1)*19)*0.02)-#mana) * 0.7;
			}
		}

	}
	[spell_summon]
	{
		template_name = ann_summonable_skeleton_magic_nature_common;
	}
}
