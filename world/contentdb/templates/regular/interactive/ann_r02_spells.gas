[t:template,n:ann_r02_spell_frostnid]
{
	category_name = "magic";
	doc = "ann_r02_spell_frostnid";
	specializes = base_spell_monster;

	[attack]
	{
		ammo_attach_bone = weapon_grip;
		ammo_template = ann_r02_spell_red;
		damage_max = 16;
		damage_min = 8;
	}
	[magic]
	{
		cast_range = 12;
		cast_reload_delay = 1;
		requires_line_of_sight = true;
		speed_bias = 1;
		target_type_flags = tt_conscious_enemy | tt_unconscious_enemy | tt_terrain;
		usage_context_flags = uc_offensive;
	}
	[physics]
	{
		velocity = 7.2;
	}
	[spell_launch]
	{
		number = 1;
    }
}
