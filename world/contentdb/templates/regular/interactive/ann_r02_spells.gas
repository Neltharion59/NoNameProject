[t:template,n:ann_r02_spell_frostnid_stream]
{
	category_name = "magic";
	doc = "ann_r02_spell_frostnid_stream";
	specializes = base_spell_monster;
	[attack]
	{
		ammo_attach_bone = weapon_grip;
		ammo_template = ann_r02_red_crystal_shard_06;
		damage_max = 2;
		damage_min = 3;
	}
	[common]
	{
		[template_triggers]
		{
			[*]
			{
				action* = call_sfx_script( "ice_shard_launch" );
				condition* = receive_world_message("we_req_cast");
			}
			[*]
			{
				action* = call_sfx_script( "ann_red_crystal_iceshard_charge" );
				condition* = receive_world_message("we_req_cast_charge");
			}
		}
	}
	[magic]
	{
		cast_range = 17;
		cast_reload_delay = 2;
		mana_cost = 0;
		requires_line_of_sight = true;
		speed_bias = 1;
		target_type_flags = tt_conscious_enemy | tt_unconscious_enemy | tt_terrain;
		usage_context_flags = uc_offensive;
	}
	[physics]
	{
		velocity = 20;
	}
	[spell_launch]
	{
		number = 30;
		use_offsets = true;
		x_offset = .5;
		y_offset = .5;
		delay_between_shots = true;
		launch_freq_min = .03;
		launch_freq_max = .04;
	}
}
