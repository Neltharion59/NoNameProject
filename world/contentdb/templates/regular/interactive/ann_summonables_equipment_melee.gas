[t:template,n:ann_wpn_summonable_skeleton_melee_rare]
{
	doc = "ann_wpn_summonable_skeleton_melee_rare";
	specializes = base_axe;
	[aspect]
	{
		model = m_w_axe_029;
		selection_indicator_scale = 0.65;
	}
	[attack]
	{
		attack_range = 0.5;
	  f damage_max = 17.000000;
	  f damage_min = 13.000000;
	}
	[common]
	{
        is_pcontent_allowed	= false;
	}
    [gui]
    {
        is_droppable = false;
    }
	[magic]
	{
		[enchantments]
		{
			[*]
			{
				alteration = alter_life_steal;
			    description			= "5 Health Stolen Per Hit";
				duration = #infinite;
				innate_enchantment = true;
				is_permanent = true;
				is_single_instance = false;
				value = 5;
                effect_script_equip	= steal_drip_05_lre;
                effect_script_hit	= hit_spark_10_lre;
			}
		}
	}
}
