    {
        is_droppable = false;
    }
	[magic]
	{
		[enchantments]
		{
			[*]
			{
				alteration = alter_life_steal;
			    description			= "8 Health Stolen Per Hit";
				duration = #infinite;
				is_permanent = true;
				is_single_instance = false;
				value = 8;
                effect_script_equip	= steal_drip_05_lre;
                effect_script_hit	= hit_spark_10_lre;
			}
            [lightning_chance]
            {
                alteration		= alter_custom_damage_chance_melee;
                custom_damage		= lightning;
                value			= 10;
                description		= "+10% Chance of Lightning Strike";
                duration		= #infinite;
                is_permanent		= true;
                is_single_instance	= false;
            }
            [lightning_damage]
            {
                alteration		= alter_custom_damage_melee;
                custom_damage		= lightning;
                value			= 10;
                max_value		= 16;
                description		= " of 10 to 16 Damage";
                duration		= #infinite;
                is_permanent		= true;
                is_single_instance	= false;
                effect_script_equip	= lightning_scythe;
                effect_script_hit	= hit_lightning_scythe;
