[t:template,n:ann_base_spell_monster_nmagic]
{
	doc = "Monster spell base template";
	specializes = spell;

	aspect:is_visible = false;
	[attack]{}
	[common]	{ is_pcontent_allowed = false;	}
	[gui]		{ is_droppable = false;			}
	[magic]
	{
		magic_class = mc_nature_magic;
		skill_class = "Nature Magic";
	}
}
[t:template,n:ann_monster_spell_leech_life_base]
{
	category_name = "magic";
	doc = "ann_monster_spell_leech_life_base";
	specializes = base_spell_monster;
	[attack]
	{
		damage_max = 0;
		damage_min = 0;
	}
	[common]
	{
		[template_triggers]
		{
			[*]
			{
				action* = call_sfx_script( "leech_life_cast" );
				condition* = receive_world_message("we_req_cast");
			}
			[*]
			{
				action* = call_sfx_script( "leech_life_charge" );
				condition* = receive_world_message("we_req_cast_charge");
			}
		}
	}
	[magic]
	{
		cast_range = 6;
		cast_reload_delay = 1;
		requires_line_of_sight = true;
		speed_bias = 1;
		target_type_flags = tt_conscious_enemy | tt_unconscious_enemy;
		usage_context_flags = uc_offensive;
		apply_enchantments = false;
		
		[enchantments]
		{
			[*]
			{
				alteration = alter_life;
				description = "leech life";
				duration = 1.1;
				frequency = 0.1;
				initial_delay = 0.0;
				is_enhancement = true;
				is_permanent = true;
				max_value = 10;
				value = ( ( #src_life > (2.0 + #magic ) ) ? (2 + #magic ) : ( ( #src_life > 0.0 ) ? #src_life : 0.0 ) )/10.0;
			}
		}
	}
	[spell_instant_hit] 
	{
		piercing		= true;
		apply_enchant	= true;
	}
}