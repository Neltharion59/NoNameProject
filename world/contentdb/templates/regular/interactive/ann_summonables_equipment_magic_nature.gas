[t:template,n:ann_spl_summonable_skeleton_nature_base_shock]
{
	category_name = "magic";
	doc = "ann_spl_summonable_skeleton_nature_base_shock";
	specializes = ann_base_spell_monster_nmagic;
	[attack]
	{
		area_damage_radius = 2;
	}
	[magic]
	{
		cast_range = 13;
		cast_reload_delay = 1;
		effect_duration = 2;
		does_damage_per_second = true;
		mana_cost = 0;
		requires_line_of_sight = true;
		target_type_flags = tt_conscious_enemy;
		usage_context_flags = uc_offensive;
	}
	[spell_damage_volume]
	{
		caster_center = false;
		effect_script = shock;
	}
}
