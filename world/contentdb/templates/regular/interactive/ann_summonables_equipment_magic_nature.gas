[t:template,n:ann_spl_summonable_skeleton_nature_base_healing_wind]
{
	category_name = "magic";
	doc = "ann_spl_summonable_skeleton_nature_base_healing_wind";
	specializes = ann_base_spell_monster_nmagic;
	[magic]
	{
		apply_enchantments = false;
		cast_range = 13;
		cast_reload_delay = 1;
		effect_duration = 5;
		mana_cost = 0;
		requires_line_of_sight = false;
		speed_bias = 1;
		state_name = "heal";
		target_type_flags = tt_self;
		usage_context_flags = uc_offensive;
	}
	[spell_mass_enchant]
	{
		effect_script	= "healing_wind";
		enchant_script	= "healing_wind_individual";
		radius			= 25.0;
		description		= "Healing";
		effect_delay	= 10;
	}
}
