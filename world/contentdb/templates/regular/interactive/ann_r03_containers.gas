[t:template,n:ann_r03_chest_1]
{
	category_name = "container";
	doc = "ann_r03_chest_1";
	specializes = base_chest;
	[common] { screen_name="Chest"; }
	[aspect]
	{
		material = steel;
		model = m_i_glb_chest-03;
		[textures]		{ 0 = b_i_glb_chest-01; }
	}
	[inventory]
	{
		[pcontent]
		{
			[all*]
			{
				[gold*]
				{
					chance = 0.50;
					max = 500;
					min = 200;
				}
				[oneof*]
				{
					il_main = #weapon/15-35;
					il_main = #body/20-50;
					il_main = #*/15-35;
					max = 2;
					min = 2;
				}
				[oneof*]
				{
					chance = 0.15;
					il_main = #weapon/-rare(1)/15-35;
					il_main = #body/-rare(1)/20-50;
					il_main = #*/-rare(1)/15-35;
				}
				[oneof*]
				{
					chance = 0.075;
					il_main = #weapon/-unique(2)/15-35;
					il_main = #body/-unique(2)/20-50;
					il_main = #*/-unique(2)/15-35;
				}
			}
		}
	}
	[body]
	{
		[chore_dictionary]
		{
			chore_prefix = a_i_ice;
			[chore_open]
			{
				skrit = transition;
				[anim_files] { 00=chest-open; }
			}
		}
	}
}
