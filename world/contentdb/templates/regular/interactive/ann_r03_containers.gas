[t:template,n:ann_r03_chest_of_drawers]
{
	category_name = "container";
	doc = "ann_r03_chest_of_drawers";
	specializes = ann_base_chest_of_drawers;
	[inventory]
	{
		[pcontent]
		{
			[all*]
			{
				[gold*]
				{
					chance = 0.20;
					max = 112;
					min = 56;
				}
				[oneof*]
				{
					chance = 0.20;
					il_main = #spell/3-10;
				}
				[oneof*]
				{
					chance = 0.20;
					il_main = potion_mana_medium;
					il_main = potion_health_medium;
				}
				[oneof*]
				{
					chance = 0.20;
					il_main = #gloves/20-50;
					il_main = #boots/20-50;
					il_main = #helm/20-50;
					il_main = #ring/5-30;
					il_main = #amulet/5-30;
				}
				[oneof*]
				{
					chance = 0.20;
					il_main = #gloves/-mod(1)/20-50;
					il_main = #boots/-mod(1)/20-50;
					il_main = #helm/-mod(1)/20-50;
					il_main = #ring/5-30;
					il_main = #amulet/5-30;
				}
				[oneof*]
				{
					chance = 0.10;
					il_main = #gloves/-rare(1)/20-50;
					il_main = #boots/-rare(1)/20-50;
					il_main = #helm/-rare(1)/20-50;
					il_main = #ring/-rare(1)/5-30;
					il_main = #amulet/-rare(1)/5-30;
				}
				[oneof*]
				{
					chance = 0.05;
					il_main = #gloves/-unique(2)/20-50;
					il_main = #boots/-unique(2)/20-50;
					il_main = #helm/-unique(2)/20-50;
					il_main = #ring/-unique(2)/5-30;
					il_main = #amulet/-unique(2)/5-30;
				}
			}
		}
	}
}
