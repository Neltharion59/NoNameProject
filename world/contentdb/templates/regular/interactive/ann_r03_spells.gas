[t:template,n:ann_flying_item_spell]
{
	category_name = "magic";
	doc = "ann_flying_item_spell";
	specializes = base_spell_monster;
	[attack]
	{
		 damage_max = 10;
		 damage_min = 2;
	}
	[common]
	{
		[template_triggers]
		{
			[*]
			{
				action* = call_sfx_script("zepheryl_zap");
				condition* = receive_world_message("we_req_cast");
			}
		}
	}
	[magic]
	{
		cast_range = 1;
		cast_reload_delay = 1;
		cast_sub_animation = 1;
		mana_cost = 0;
		requires_line_of_sight = true;
		speed_bias = 1;
		target_type_flags = tt_conscious_enemy;
		usage_context_flags = uc_offensive;
		magic_class = mc_combat_magic;
		skill_class = "Combat Magic";
	}
	[spell_instant_hit] {}
}

[t:template,n:ann_monster_spell_leech_life_r03_1]
{
	category_name = "magic";
	doc = "ann_monster_spell_leech_life_r03_1";
	specializes = ann_monster_spell_leech_life_base;
	[attack]
	{
		damage_max = 12;
		damage_min = 12;
	}
	[magic]
	{
		usage_context_flags = uc_life_giving;
		[enchantments]
		{
			[*]
			{
				alteration = alter_life;
				description = "leech life";
				duration = 1.1;
				frequency = 0.1;
				initial_delay = 0.0;
				is_enhancement = true;
				is_permanent = true;
				value = ( ( #src_life > 12 ) ? 12 : ( ( #src_life > 0.0 ) ? #src_life : 0.0 ) )/10.0;
			}
		}
	}
}
