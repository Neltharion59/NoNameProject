[t:template,n:ann_monster_spell_bombard_soul]
{
	category_name = "magic";
	doc = "ann_monster_spell_bombard_soul";
	specializes = base_spell_monster;
	[attack]
	{
		area_damage_radius = 2;
		damage_max = 20;
		damage_min = 10;
	}
	[common]
	{
		[template_triggers]
		{
			[*]
			{
				action* = call_sfx_script("ann_effect_soul_bombard");
				condition* = receive_world_message("we_req_cast");
			}
		}
	}
	[magic]
	{
		cast_range = 16;
		cast_reload_delay = 1;
		requires_line_of_sight = true;
		speed_bias = 1;
		target_type_flags = tt_conscious_enemy | tt_unconscious_enemy | tt_terrain;
		usage_context_flags = uc_offensive;
	}
	[spell_default] {}
}