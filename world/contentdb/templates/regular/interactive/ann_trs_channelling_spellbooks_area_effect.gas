[t:template,n:ann_spellbook_chanelling_area_effect_base]
{
	doc = "ann_spellbook_chanelling_area_effect_base";
	specializes = ann_spellbook_chanelling_base;
	[aspect]
	{
		[textures]
		{
			0 = b_i_glb_book-magic-04;
		}
	}
    [common]
    {
        screen_name = "Channelling Spellbook of Area Effect";
    }
	[gui]
	{

		inventory_icon = b_gui_ig_i_it_magic-book-04;
	}
}
[t:template,n:ann_spellbook_chanelling_area_effect_stronger_01]
{
	doc = "ann_spellbook_chanelling_area_effect_stronger_01";
	specializes = ann_spellbook_chanelling_area_effect_base;
	[magic]
	{
		[enchantments]
		{
			[*]
			{
				alteration = alter_spell_damage;
			    imbued_spell_group = spells_area_effect;
                is_imbued = true;
                multiply_value = true;
                value = 25;
			    description = "Increases the damage of Area Effect spells in this spellbook by 25% at the proportional cost of mana";
				duration = #infinite;
				innate_enchantment = true;
				is_permanent = true;
				is_single_instance = false;
			}
            [*]
            {
                alteration = alter_spell_cost;
			    imbued_spell_group = spells_area_effect;
                is_imbued = true;
                multiply_value = true;
                value = -25;
                duration = #infinite;
                is_permanent = true;
                is_single_instance = false;
            }
        }
	}
}
