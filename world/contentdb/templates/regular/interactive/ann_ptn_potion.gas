[t:template,n:potion_regret]
{
	specializes         = base_potion_good;
	doc                 = "potion_regret";
	category_name       = "potions";

	aspect:model        = m_i_glb_bottle-potion;
	aspect:textures:0   = b_i_glb_bottle-slurm;
   	aspect:gold_value   = 140;

	[common]
	{
		screen_name  = "Regret Potion";
		[template_triggers]
		{
			[*]
			{
				action* = call_sfx_script( "gold_sparkle" );
				condition* = receive_world_message("we_dropped");
			}
			[*]
			{
				action* = call_sfx_script( "gold_sparkle" );
				condition* = receive_world_message("we_dropped");
			}
		}
	}
	[magic]
	{
        pcontent_level = 45;
		[enchantments]
		{
			[*]
			{
				alteration          = alter_mana;
				value               = 1800.0;
				//description         = "Raise Mana";
				duration            = 0;
				frequency           = 0;
				is_active           = false;
				is_enhancement      = true;
				is_permanent        = true;
				is_single_instance  = false;
				is_transmissible    = false;
				is_value_limited    = true;
				effect_script_equip = rejuv_potion_small;
			}
			[*]
			{
				alteration          = alter_life;
				value               = 1800.0;
				//description         = "Raise Health";
				duration            = 0;
				frequency           = 0;
				is_active           = false;
				is_enhancement      = true;
				is_permanent        = true;
				is_single_instance  = false;
				is_transmissible    = false;
				is_value_limited    = true;
			}
		}
	}

	gui:inventory_icon          = b_gui_ig_i_it_potion-bottle-regret;

	potion:inventory_icon_2     = b_gui_ig_i_it_potion-fill-regret;
}