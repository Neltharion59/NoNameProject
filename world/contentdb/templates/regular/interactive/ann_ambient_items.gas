[t:template,n:ann_ambient_item_r01_non_blocking_krug_animated_base]
{
	category_name = "outdoor";
	doc = "ann r01 Ambient Item non_blocking krug animated base";
	specializes = ann_ambient_item_base;
	[aspect] { model= m_c_eam_kg_pos_1; }
	[body]
	{
		[bone_translator]
		{
			body_anterior  = bip01_head;
			body_mid       = Bip01_Spine3;
			body_posterior = bip01_pelvis;
			kill_bone      = Bip01_Spine3;
			shield_bone    = shield_grip;
			weapon_bone    = weapon_grip;
		}
		initial_chore = chore_default;
		[chore_dictionary]
		{
			chore_prefix = a_c_eam_kg_fs;
			[chore_default]
			{
				chore_stances = 0;
				skrit = simple_loop;
				[anim_files]
				{
					00 = wl;
				}
			}
		}
	}
}
