[t:template,n:ann_ambient_item_01_invisible_blocking_rectangle]
{
	specializes = ann_ambient_item_base;
	doc			= "cap_black";
	category_name       ="node";

	[aspect]
	{
		does_block_path = true;
		draw_selection_indicator	= true;
		force_no_render = true;
		force_no_render_click = true;
		is_collidable   = true;
		model		= m_i_glb_cap;
	}
}