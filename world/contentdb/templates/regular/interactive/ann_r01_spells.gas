[t:template,n:ann_01_spell_dark_leech]
{
	category_name = "magic";
	doc = "ann r01 spell dark leech";
	specializes = base_spell_dark;
	[attack]
	{
		damage_max = 0;
		damage_min = 0;
	}
	[common]
	{
		screen_name = "Dark Leech";
	}
	[common]
	{
		description = "Tears <alter_life> Health and <alter_mana> Mana from the Enemy and gives it to the Caster. Little Tibby will it when wounded or out of mana.";
		[template_triggers]
		{
            // TODO - custom sparkle
			[*]
			{
				action* = call_sfx_script( "combat_spell_sparkle" );
				condition* = receive_world_message("we_dropped");
			}
			[*]
			{
				action* = call_sfx_script( "leech_life_cast" );
				condition* = receive_world_message("we_req_cast");
			}
			[*]
			{
				action* = call_sfx_script( "leech_life_charge" );
				condition* = receive_world_message("we_req_cast_charge");
			}
			[*]
			{
				action* = call_sfx_script("rip_mana");
				condition* = receive_world_message("we_req_cast");
			}
		}
	}// TODO custom icons
	[gui]
	{
		active_icon = b_gui_ig_i_ic_sp_080;
		inventory_icon = b_gui_ig_i_ic_sp_080_inv;
		equip_requirements = dark_aptitude:1;
	}
	[magic]
	{
		attack_damage_modifier_max = (30 + #magic * 3 )-1;
		attack_damage_modifier_min = (30 + #magic * 3 )-1;
		cast_experience = (#magic*.3)+1;
		cast_range = 12;
		cast_reload_delay = 10;
		mana_cost = 3;
		mana_cost_modifier = (#magic*2);
		max_level = 180;
		required_level = 1;
		requires_line_of_sight = true;
		speed_bias = 1;
		target_type_flags = tt_conscious_enemy | tt_unconscious_enemy;
		usage_context_flags = uc_life_giving | uc_mana_giving;
		apply_enchantments = false;
		
		[enchantments]
		{
			[*]
			{
				alteration = alter_life;
				description = "leech life";
				duration = 1.1;
				frequency = 0.1;
				initial_delay = 0.0;
				is_enhancement = true;
				is_permanent = true;
				max_value = 10;
				value = ( ( #src_life > (30.0 + #magic * 3 ) ) ? (30 + #magic * 3 ) : ( ( #src_life > 0.0 ) ? #src_life : 0.0 ) )/10.0;
			}
			[*]
			{
				alteration = alter_mana;
				description = "mana channel";
				effect_script = mana_trail;
				initial_delay = 0.0;
				is_enhancement = true;
				is_permanent = true;
				is_source_transfer = true;
				is_target_transfer = false;
				is_offensive_transfer = true;
				transfer_efficiency = 1;
				value = 10+2*#magic;
			}
		}
	}
	[spell_instant_hit] 
	{
		piercing		= true;
		apply_enchant	= true;
	}
}
[t:template,n:ann_01_spell_satanic_book]
{
	category_name = "magic";
	doc = "ann r01 spell satanic book";
	specializes = base_spell_dark;
	[attack]
	{
		damage_max = 0;
		damage_min = 0;
	}
	[common]
	{
		description = "Recites dark incantation to hurt the target. Deals devastating damage to weak targets. Deals damage based on target max Health against bosses.";
		screen_name = "Dark Incantation";
		[template_triggers]
		{
			[*]
			{
				action* = call_sfx_script( "combat_spell_sparkle" );
				condition* = receive_world_message("we_dropped");
			}
			[*]
			{
				action* = call_sfx_script( "ann_effect_shadow_strike" );
				condition* = receive_world_message("we_req_cast");
			}
			[*]
			{
				action* = call_sfx_script( "ann_effect_shadow_strike_charge" );
				condition* = receive_world_message("we_req_cast_charge");
			}
		}
	}
	[gui]
	{// TODO - custom icons
		active_icon = b_gui_ig_i_ic_sp_075;
		inventory_icon = b_gui_ig_i_ic_sp_075_inv;
		equip_requirements = dark_aptitude:1;
	}
	[magic]
	{
		attack_damage_modifier_max = ((#magic+1)**1.15*1.92)*(1+((1/(#magic+12))+.02)) * 0.33;
		attack_damage_modifier_min = ((#magic+1)**1.15*1.92)*(1-((1/(#magic+12))+.02)) * 0.33;
		cast_range = 12;
		cast_reload_delay = 6;
		mana_cost = 1;
		mana_cost_modifier = (#magic*3.35)+.22;
		max_level = 180;
		required_level = 1;
		speed_bias = 1;
		target_type_flags = tt_conscious_enemy | tt_unconscious_enemy;
		usage_context_flags = uc_offensive;
	}
	[ann_spell_instant_hit_extended] 
	{
		piercing		= true;
		apply_enchant	= true;
		max_hp_damage_ratio = 0.03;
	}
}
[t:template,n:ann_r01_spell_rector_burn]
{
	category_name = "magic";
	doc = "ann_r01_spell_rector_burn";
	specializes = base_spell_monster;
