[t:template,n:ann_spl_summonable_skeleton_combat_legendary_turncoat]
{
	category_name = "magic";
	doc = "ann_spl_summonable_skeleton_combat_legendary_turncoat";
	specializes = base_spell_monster;

	[magic]
	{
		cast_range = 10;
		cast_reload_delay = 1;
		effect_duration = 7;
		mana_cost = 0;

		apply_enchantments = false;

		requires_line_of_sight = true;
		speed_bias = 1;
		target_type_flags = tt_conscious_enemy;
		target_type_flags_not =	 tt_self | tt_human_party_member;
		usage_context_flags = uc_offensive;
		state_name = "Turncoat";
	}

	[spell_turncoat] 
	{
		caster_script = "turncoat_cast";
		effect_script = "turncoat_effect";
		state_description = "Turned";
		immunity = "immune_control";
	}
}