[t:template,n:ann_spl_summonable_skeleton_combat_base_leech_life]
{
	category_name = "magic";
	doc = "ann_spl_summonable_skeleton_combat_base_leech_life";
	specializes = base_spell_monster;
	[common]
    {
		[template_triggers]
		{
			[*]
			{
				action* = call_sfx_script( "leech_life_cast" );
				condition* = receive_world_message("we_req_cast");
			}
			[*]
			{
				action* = call_sfx_script( "leech_life_charge" );
				condition* = receive_world_message("we_req_cast_charge");
			}
		}
	}
	[magic]
	{
		cast_range = 11;
		cast_reload_delay = 1;
		mana_cost = 0;
		requires_line_of_sight = true;
		speed_bias = 1;
		target_type_flags = tt_conscious_enemy | tt_unconscious_enemy;
		usage_context_flags = uc_offensive;
		apply_enchantments = false;
	}
	[spell_instant_hit] 
	{
		piercing		= true;
		apply_enchant	= true;
	}
}
[t:template,n:ann_spl_summonable_skeleton_combat_common_leech_life]
{
	category_name = "magic";
	doc = "ann_spl_summonable_skeleton_combat_common_leech_life";
	specializes = ann_spl_summonable_skeleton_combat_base_leech_life;
	[attack]
	{
		damage_max = 4;
		damage_min = 4;
	}
	[magic]
	{
		[enchantments]
		{
			[*]
			{
				alteration = alter_life;
				description = "leech life";
				duration = 1.1;
				frequency = 0.1;
				initial_delay = 0.0;
				is_enhancement = true;
				is_permanent = true;
				value = ( ( #src_life > (4) ) ? (4) : ( ( #src_life > 0.0 ) ? #src_life : 0.0 ) )/10.0;
			}
		}
	}
}
