[t:template,n:ann_amr_hlmt_summonable_skeleton_cmagic_rare]
{
	doc = "ann_amr_hlmt_summonable_skeleton_cmagic_rare";
	specializes = base_helm;
	[common]
	{
        is_pcontent_allowed	= false;
	}
    [gui]
    {
        is_droppable = false;
    }
	[defend]
	{
		armor_style = 038;
		armor_type = type38;
	  f defense = 1.000000;
	}
	[magic]
	{
		[enchantments]
		{
			[*]
			{
				alteration = alter_special_defense;
				special_defense = fireshot;
				description = "+10% Chance to Cast fireshot (10-30 DMG) on Taking Damage";
				duration = #infinite;
				is_permanent = true;
				is_single_instance = false;
				value = 10;
				special_defense_skrit = world\global\skrits\special_defense.skrit?damage_min=10&damage_max=30&effect_script="fireshot";
			}
			[*]
			{
				alteration = alter_chance_to_block_cmagic_damage;
			    description			= "+15% Chance to Block Magic Attacks";
				duration = #infinite;
				is_permanent = true;
				is_single_instance = false;
				value = 15;
			}
			[*]
			{
				alteration = alter_chance_to_block_nmagic_damage;
				duration = #infinite;
				is_permanent = true;
				is_single_instance = false;
				value = 15;
			}
		}
	}
}
