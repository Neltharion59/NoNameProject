[t:template,n:ann_r01_reward_pickpocket]
{
	specializes 		= inventory;
	doc 				= "ann r01 reward pickpocket";
    category_name       = "generator";
    
	[aspect]
	{
		is_visible = false;
		force_no_render = true;
		is_selectable = false;
	}
    common:is_pcontent_allowed = false;
	[generator_multiple_mp] {}
	[inventory]
	{
		[delayed_pcontent]
        {
            [all*]
            {
                [oneof*]
                {
                    chance = 1.00;
                    il_main = #spell/0-2;
                    il_main = #bow/1-3;
                    il_main = #body/1-6;
                    il_main = #melee/1-3;
                    il_main = #club/2-3;
                }
                [oneof*]
                {
                    chance = 0.10;
                    il_main = potion_health_small;
                    il_main = potion_mana_small;
                }
                [oneof*]
                {
                    chance = 0.10;
                    il_main = #spell/0-2;
                }
                [oneof*]
                {
                    chance = 0.10;
                    il_main = #weapon/1-5;
                    il_main = #armor/3-8;
                    il_main = #*/1-5;
                }
                [oneof*]
                {
                    chance = 0.10;
                    il_main = #weapon/-mod(1)/1-5;
                    il_main = #armor/-mod(1)/3-8;
                    il_main = #*/-mod(1)/1-5;
                }
                [oneof*]
                {
                    chance = 0.10;
                    il_main = #weapon/-rare(1)/1-5;
                    il_main = #armor/-rare(1)/3-8;
                    il_main = #*/-rare(1)/1-5;
                }
                [oneof*]
                {
                    chance = 0.10;
                    il_main = #weapon/-unique(2)/1-5;
                    il_main = #armor/-unique(2)/3-8;
                    il_main = #*/-unique(2)/1-5;
                }
            }
		}
	}
}