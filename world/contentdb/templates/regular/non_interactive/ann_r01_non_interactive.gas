// We need non-blocking versions of normally blocking items so that the pickpocket can run smoothly
[t:template,n:ann_r01_non_blocking_base]
{
	category_name = "outdoor";
	doc = "ann r01 non_blocking base";
	specializes = non_interactive_nonblocking;
}
[t:template,n:ann_r01_non_blocking_tent_grs_camp]
{
	category_name = "outdoor";
	doc = "ann r01 non_blocking tent_hide";
	specializes = ann_r01_non_blocking_base;
	[aspect] { model=m_i_grs_tent-camp; }
}
// Animated krug in the cages
[t:template,n:ann_r01_non_blocking_krug_animated_base]
{
	category_name = "outdoor";
	doc = "ann r01 non_blocking krug animated base";
	specializes = ann_r01_non_blocking_base;
	[aspect] { model= m_c_eam_kg_pos_1; }
	[body]
	{
		[bone_translator]
		{
			body_anterior  = bip01_head;
			body_mid       = Bip01_Spine3;
			body_posterior = bip01_pelvis;
			kill_bone      = Bip01_Spine3;
			shield_bone    = shield_grip;
			weapon_bone    = weapon_grip;
		}
		initial_chore = chore_default;
		[chore_dictionary]
		{
			chore_prefix = a_c_eam_kg_fs;
			[chore_default]
			{
				chore_stances = 0;
				skrit = simple_loop;
				[anim_files]
				{
					00 = dsf;
					01 = dsf-02;
					02 = dsf-03;
				}
			}
		}
	}
}
[t:template,n:ann_r01_non_blocking_krug_animated_01]
{
	category_name = "outdoor";
	doc = "ann r01 non_blocking krug animated 01";
	specializes = ann_r01_non_blocking_krug_animated_base;
	[aspect]
	{
		scale_base = 0.85;
		[textures]
		{
			0 = b_c_eam_ksv;
		}
	}
}
[t:template,n:ann_r01_non_blocking_krug_animated_02]
{
	category_name = "outdoor";
	doc = "ann r01 non_blocking krug animated 02";
	specializes = ann_r01_non_blocking_krug_animated_base;
	[aspect]
	{
		scale_base = 0.9;
		[textures]
		{
			0 = b_c_eam_ksc;
		}
	}
}