// We need non-blocking versions of normally blocking items so that the pickpocket can run smoothly
[t:template,n:ann_r01_non_blocking_base]
{
	category_name = "outdoor";
	doc = "ann r01 non_blocking base";
	specializes = non_interactive_nonblocking;
}
